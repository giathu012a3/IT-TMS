@startuml
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
    FontSize 12
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.2
    ArrowColor #2563EB
    FontColor #0F172A
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #94A3B8
    BorderThickness 1.5
    FontColor #1E293B
    FontSize 13
    FontStyle bold
}

left to right direction

actor "Trưởng nhóm\n(Leader)" as Leader #FEFCE8

rectangle "Phân hệ Trưởng nhóm (Leader Subsystem - IT-TMS)" {

    usecase "UC11: Xem Dashboard chỉ huy & Giám sát SLA\n(Tỷ lệ tuân thủ SLA, Vé vi phạm, Tải KTV)" as UC11
    
    usecase "UC12: Tra cứu đa tiêu chí tất cả yêu cầu\n(View All Tickets)" as UC12
    usecase "Lọc theo từ khóa, trạng thái,\nphân loại sự cố & kỹ thuật viên" as UC_FilterLeader
    
    usecase "Tiếp nhận hàng đợi yêu cầu mới\n(New Queue - Lọc ưu tiên & SLA)" as UC_NewQueue
    
    usecase "UC09: Phân công yêu cầu cho Kỹ thuật viên\n(Assign Ticket: New -> Assigned)" as UC09
    usecase "Điều chuyển kỹ thuật viên xử lý\n(Reassign Ticket)" as UC_Reassign
    usecase "Kiểm tra kỹ thuật viên hợp lệ & Active\n(Tránh giao cho KTV bị vô hiệu hóa)" as UC_CheckStaff
    
    usecase "UC10: Từ chối tiếp nhận yêu cầu\n(Reject Ticket: New -> Rejected)" as UC10
    usecase "Nhập lý do từ chối yêu cầu\n(Ghi nhận RejectionReason vào CSDL)" as UC_Reason
    usecase "Kiểm tra chặn từ chối vé đang xử lý\n(Ràng buộc TC-06: Chặn Reject khi InProgress)" as UC_BlockReject
    
    usecase "UC08: Xem chi tiết toàn diện yêu cầu\n(Bao gồm tiến độ, SLA và tệp đính kèm)" as UC08_Leader
    usecase "UC06: Thảo luận & Ghi chú điều phối nội bộ\n(Ghi chú nội bộ IsInternal = true)" as UC06_Leader

    package "Mẫu thiết kế Hướng đối tượng hỗ trợ" #F1F5F9 {
        usecase "Khởi tạo & Quản lý trạng thái\n(Factory Method / Flyweight: TicketStateFactory)" as UC_Factory
        usecase "Bảo vệ quy tắc chuyển trạng thái\n(State Pattern - Fail-Closed)" as UC_State
        usecase "Phát thông báo SignalR & Ghi SystemLog\n(Observer Pattern: Notification & SystemLog)" as UC_Observer
    }
}

Leader --> UC11
Leader --> UC12
Leader --> UC_NewQueue
Leader --> UC09
Leader --> UC_Reassign
Leader --> UC10
Leader --> UC08_Leader
Leader --> UC06_Leader

' Quan hệ Include & Extend
UC12 <.. UC_FilterLeader : <<extend>>
UC_NewQueue ..> UC09 : <<extend>>
UC_NewQueue ..> UC10 : <<extend>>

UC09 ..> UC_CheckStaff : <<include>>
UC09 ..> UC_State : <<include>>
UC09 ..> UC_Observer : <<include>>

UC_Reassign ..> UC_CheckStaff : <<include>>
UC_Reassign ..> UC_State : <<include>>
UC_Reassign ..> UC_Observer : <<include>>

UC10 ..> UC_Reason : <<include>>
UC10 ..> UC_BlockReject : <<include>>
UC10 ..> UC_State : <<include>>
UC10 ..> UC_Observer : <<include>>

UC06_Leader ..> UC_Observer : <<include>>

UC_State ..> UC_Factory : <<include>>

@enduml
