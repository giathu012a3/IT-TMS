@startuml
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 6

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #334155
    ActorBackgroundColor #EFF6FF
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #FFFFFF
    BoxBorderColor #CBD5E1
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F1F5F9
}

actor "Kỹ thuật viên\n(Staff)" as Staff #F0FDF4
participant "StaffController" as Controller #EFF6FF

box "Tầng Dữ liệu & An ninh CSDL" #FAFAFA
participant "ItTmsDbContext" as DbContext #F1F5F9
end box

box "Mẫu thiết kế State Pattern (Vòng đời Ticket)" #FAFAFA
participant "Ticket\n<<Context>>" as Ticket #EFF6FF
participant "AssignedState\n<<ConcreteState>>" as AssignedState #FEFCE8
participant "InProgressState\n<<ConcreteState>>" as InProgressState #F0FDF4
end box

box "Mẫu Observer & Thời gian thực SignalR" #FAFAFA
participant "DomainEventDispatcher" as Dispatcher #FEFCE8
participant "TicketHub\n<<SignalR Hub>>" as Hub #EFF6FF
end box

actor "Người dùng\n(User)" as User #EFF6FF

Staff -> Controller : POST /Staff/StartProgress (id = ticketId)
activate Staff
activate Controller #EFF6FF

Controller -> DbContext : Tickets.Include(Status).FirstOrDefaultAsync(t => t.Id == id)
activate DbContext #F1F5F9
DbContext --> Controller : ticket
deactivate DbContext

alt #FEF2F2 BẢNG 7.2 TC-07: Vi phạm phân quyền BOLA / IDOR (ticket.AssignedToId != CurrentUserId)
    Controller --> Staff : HTTP 403 Forbidden (Chặn kỹ thuật viên truy cập vé người khác)
end

' Gọi phương thức State Pattern
Controller -> Ticket : StartProgress(staffId)
activate Ticket #EFF6FF

Ticket -> AssignedState : StartProgress(ticket, staffId)
activate AssignedState #FEFCE8

alt #FEF2F2 BẢNG 7.2 TC-05: Chuyển đổi trạng thái không hợp lệ (Không phải AssignedState)
    AssignedState --> Ticket : Result.Failure("Trạng thái hiện tại không cho phép bắt đầu xử lý")
    Ticket --> Controller : Result.Failure(error)
    Controller --> Staff : RedirectToAction("Details") kèm thông báo lỗi
end

AssignedState -> InProgressState : TransitionTo(InProgressState)
AssignedState -> Ticket : Gán StatusId = 3 (InProgress), UpdatedAt = UtcNow
AssignedState -> Ticket : AddDomainEvent(TicketStatusChangedEvent)
AssignedState --> Ticket : Result.Success()
deactivate AssignedState

Ticket --> Controller : Result.Success()
deactivate Ticket

Controller -> DbContext : SystemLogs.Add("Ticket InProgress", "Staff bắt đầu xử lý")
Controller -> DbContext : SaveChangesAsync()
activate DbContext #F1F5F9

DbContext -> Dispatcher : DispatchInTransactionAsync(TicketStatusChangedEvent)
activate Dispatcher #FEFCE8
Dispatcher -> DbContext : Notifications.Add(Tạo thông báo cho User tạo ticket)
deactivate Dispatcher

DbContext -> DbContext : SQLite Commit

DbContext -> Dispatcher : DispatchPostCommitAsync(TicketStatusChangedEvent)
activate Dispatcher #FEFCE8
Dispatcher -> Hub : Clients.Group("ticket_{id}").SendAsync("TicketStatusChanged", statusDto)
activate Hub #EFF6FF

Hub --> User : WebSocket Broadcast: Cập nhật nhãn trạng thái "Đang xử lý" tức thì
Hub --> Staff : WebSocket Broadcast: Cập nhật giao diện realtime
deactivate Hub

Dispatcher -> Hub : Clients.User(creatorId).SendAsync("ReceiveNotification", notifDto)
activate Hub #EFF6FF
Hub --> User : WebSocket Push: Floating Card thông báo KTV đã tiếp nhận
deactivate Hub
deactivate Dispatcher

DbContext --> Controller : rowsAffected > 0
deactivate DbContext

Controller --> Staff : RedirectToAction("Details", new { id = ticket.Id })
deactivate Controller
deactivate Staff

@enduml
