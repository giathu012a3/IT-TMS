@startuml Hinh6_1_StatePattern_ClassDiagram
!theme plain
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 6
skinparam linetype ortho

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    HeaderBackgroundColor #F1F5F9
    ArrowColor #2563EB
    BorderThickness 1.2
}

interface ITicketState {
    + StatusId : int { get; }
    + Name : string { get; }
    + DisplayLabel : string { get; }
    + CanComment : bool { get; }
    + Assign(staff: User, leader: User) : Result
    + Assign(staffId: int, leaderId: int) : Result
    + Reassign(staff: User, leader: User) : Result
    + Reassign(staffId: int, leaderId: int) : Result
    + StartProgress(staff: User) : Result
    + StartProgress(staffId: int) : Result
    + HoldForInfo(reason: string, staff: User) : Result
    + HoldForInfo(reason: string, staffId: int) : Result
    + Resolve(staff: User) : Result
    + Resolve(staffId: int) : Result
    + Close(feedback: Feedback, user: User) : Result
    + Close(userId: int) : Result
    + Reopen(reason: string, user: User) : Result
    + Reopen(userId: int) : Result
    + Reject(reason: string, leader: User) : Result
    + Reject(reason: string, leaderId: int) : Result
}

abstract class TicketStateBase implements ITicketState {
    # Ticket : Ticket { get; }
    # TicketStateBase(ticket: Ticket)
    + {abstract} StatusId : int
    + {abstract} Name : string
    + {abstract} DisplayLabel : string
    + CanComment : bool
    -- Fail-Closed Architecture --
    + Assign(staffId: int, leaderId: int) : Result
    + Reassign(staffId: int, leaderId: int) : Result
    + StartProgress(staffId: int) : Result
    + HoldForInfo(reason: string, staffId: int) : Result
    + Resolve(staffId: int) : Result
    + Close(userId: int) : Result
    + Reopen(userId: int) : Result
    + Reject(reason: string, leaderId: int) : Result
}

class NewState extends TicketStateBase {
    + StatusId : int = 1
    + Name : string = "New"
    + DisplayLabel : string = "Mới tạo"
    + CanComment : bool = true
    + Assign(staffId: int, leaderId: int) : Result
    + Reject(reason: string, leaderId: int) : Result
}

class AssignedState extends TicketStateBase {
    + StatusId : int = 2
    + Name : string = "Assigned"
    + DisplayLabel : string = "Đã phân công"
    + CanComment : bool = true
    + StartProgress(staffId: int) : Result
    + Reassign(staffId: int, leaderId: int) : Result
}

class InProgressState extends TicketStateBase {
    + StatusId : int = 3
    + Name : string = "InProgress"
    + DisplayLabel : string = "Đang xử lý"
    + CanComment : bool = true
    + HoldForInfo(reason: string, staffId: int) : Result
    + Resolve(staffId: int) : Result
    + Reassign(staffId: int, leaderId: int) : Result
}

class WaitingState extends TicketStateBase {
    + StatusId : int = 4
    + Name : string = "Waiting"
    + DisplayLabel : string = "Chờ phản hồi"
    + CanComment : bool = true
    + StartProgress(staffId: int) : Result
    + Resolve(staffId: int) : Result
    + Reassign(staffId: int, leaderId: int) : Result
}

class ResolvedState extends TicketStateBase {
    + StatusId : int = 5
    + Name : string = "Resolved"
    + DisplayLabel : string = "Đã giải quyết"
    + CanComment : bool = false
    + Close(feedback: Feedback, user: User) : Result
    + Close(userId: int) : Result
    + Reopen(reason: string, user: User) : Result
    + Reopen(userId: int) : Result
}

class ClosedState <<Terminal>> extends TicketStateBase {
    + StatusId : int = 6
    + Name : string = "Closed"
    + DisplayLabel : string = "Đã đóng"
    + CanComment : bool = false
}

class RejectedState <<Terminal>> extends TicketStateBase {
    + StatusId : int = 7
    + Name : string = "Rejected"
    + DisplayLabel : string = "Đã từ chối"
    + CanComment : bool = false
}

class Ticket <<Context>> {
    - _currentState : ITicketState
    - _statusId : int
    + Id : int
    + Title : string
    + DueAt : DateTime
    + ConcurrencyToken : Guid
    + StatusId : int { get; set; }
    + CurrentState : ITicketState { get; }
    + CanComment() : bool
    ~ TransitionTo(nextState: ITicketState, changedByUserId: int) : void
    + Assign(staffId: int, leaderId: int) : Result
    + Reassign(staffId: int, leaderId: int) : Result
    + StartProgress(staffId: int) : Result
    + HoldForInfo(reason: string, staffId: int) : Result
    + Resolve(staffId: int) : Result
    + Close(feedback: Feedback, user: User) : Result
    + Reopen(reason: string, user: User) : Result
    + Reject(reason: string, leaderId: int) : Result
}

class TicketStateFactory <<Factory Method>> {
    + {static} CreateState(ticket: Ticket, statusId: int) : ITicketState
}

class Result <<Railway-Oriented>> {
    + IsSuccess : bool
    + IsFailure : bool
    + Error : Error
    + {static} Success() : Result
    + {static} Failure(error: Error) : Result
}

Ticket o--> ITicketState : delegates behavior (_currentState)
Ticket ..> TicketStateFactory : creates state via
TicketStateFactory ..> ITicketState : instantiates
TicketStateBase o--> Ticket : holds context reference
ITicketState ..> Result : returns transition result

note right of ResolvedState
  **TC-08**: Khóa gửi bình luận (CanComment = false)
end note

note right of ClosedState
  **Terminal State**: Mọi chuyển đổi
  trả về Result.Failure(TicketAlreadyClosed)
end note

note right of RejectedState
  **Terminal State**: Mọi chuyển đổi
  trả về Result.Failure(TicketAlreadyRejected)
end note

@enduml
