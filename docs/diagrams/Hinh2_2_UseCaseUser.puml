@startuml
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
    FontSize 12
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.2
    ArrowColor #2563EB
    FontColor #0F172A
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #94A3B8
    BorderThickness 1.5
    FontColor #1E293B
    FontSize 13
    FontStyle bold
}

left to right direction

actor "Người dùng\n(User)" as User #EFF6FF

rectangle "Phân hệ Người dùng (User Subsystem - IT-TMS)" {

    usecase "UC20: Xem Dashboard cá nhân\n(Chỉ số yêu cầu cá nhân & Bảng tin)" as UC20
    usecase "UC02: Xem danh sách yêu cầu cá nhân\n(Danh sách Ticket cá nhân)" as UC02
    usecase "Lọc yêu cầu theo trạng thái\n(Tất cả / Đang xử lý / Đã giải quyết / Đã đóng)" as UC_Filter
    
    usecase "UC03: Gửi yêu cầu hỗ trợ mới\n(Create Ticket)" as UC03
    usecase "Đính kèm tệp tin minh chứng\n(Tối đa 16MB - GUID Naming)" as UC_Attach
    usecase "Tự động tính thời hạn cam kết SLA\n(DueAt theo Priority: Low/Med/High/Crit)" as UC_SLA
    
    usecase "UC08: Xem chi tiết tiến độ yêu cầu\n(Bảo vệ chống BOLA/IDOR)" as UC08
    usecase "UC06: Trao đổi trực tiếp thời gian thực\n(SignalR WebSocket Chat - Phím Enter)" as UC06
    
    usecase "UC19: Nghiệm thu và đóng yêu cầu\n(Close Ticket - Resolved -> Closed)" as UC19
    usecase "UC04: Đánh giá chất lượng hỗ trợ\n(Rating 1-5 sao & Nhận xét phản hồi)" as UC04
    usecase "Mở lại yêu cầu chưa hoàn tất\n(Reopen Ticket - Resolved -> InProgress)" as UC_Reopen
    
    package "Mẫu thiết kế Hướng đối tượng hỗ trợ" #F1F5F9 {
        usecase "Kiểm tra trạng thái hợp lệ\n(State Pattern - ITicketState)" as UC_State
        usecase "Phát thông báo & Ghi nhật ký\n(Observer Pattern: Notification & SystemLog)" as UC_Observer
    }
}

User --> UC20
User --> UC02
User --> UC03
User --> UC08
User --> UC06
User --> UC19
User --> UC_Reopen

' Quan hệ Include & Extend
UC02 <.. UC_Filter : <<extend>>
UC03 <.. UC_Attach : <<extend>>
UC03 ..> UC_SLA : <<include>>
UC03 ..> UC_Observer : <<include>>

UC06 ..> UC_State : <<include>>
UC06 ..> UC_Observer : <<include>>

UC19 ..> UC04 : <<include>>
UC19 ..> UC_State : <<include>>
UC19 ..> UC_Observer : <<include>>

UC_Reopen ..> UC_State : <<include>>
UC_Reopen ..> UC_Observer : <<include>>

@enduml
