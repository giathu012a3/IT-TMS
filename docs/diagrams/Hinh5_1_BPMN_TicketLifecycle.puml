@startuml Hinh5_1_BPMN_TicketLifecycle
!theme plain
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 8

skinparam activity {
    BackgroundColor #FFFFFF
    BorderColor #334155
    ArrowColor #2563EB
    BorderThickness 1.2
    FontSize 11
}

skinparam partition {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    BorderThickness 1.0
    FontSize 12
    FontStyle bold
}

|#EFF6FF|Người dùng (User)|
start
:Gửi yêu cầu hỗ trợ kỹ thuật (UC03)
(Tiêu đề, mô tả, phân loại, độ ưu tiên, đính kèm tệp);
-> Trạng thái: **New**;

|#F8FAFC|Hệ thống IT-TMS (System & SignalR)|
:Lưu DB (SQLite WAL) & Tính SLA DueAt;
:Kích hoạt Domain Event (TicketCreatedEvent);
:Đẩy thông báo thời gian thực tới Leader qua SignalR;

|#F0FDF4|Trưởng nhóm IT (Leader)|
:Kiểm tra hàng đợi New Tickets (UC12);
if (Đánh giá yêu cầu hợp lệ?) then (Không hợp lệ / Trùng lặp)
    :Từ chối yêu cầu tiếp nhận (UC10)
    (Nhập lý do từ chối);
    -> Trạng thái: **Rejected**;
    
    |#F8FAFC|Hệ thống IT-TMS (System & SignalR)|
    :Cập nhật trạng thái Rejected & Ghi SystemLog;
    :Bắn SignalR thông báo lý do từ chối;
    
    |#EFF6FF|Người dùng (User)|
    :Nhận Floating Card Box thông báo bị từ chối;
    stop
else (Hợp lệ & Sẵn sàng)
    :Phân công Kỹ thuật viên phụ trách (UC09)
    (Chọn kỹ thuật viên khả dụng);
    -> Trạng thái: **Assigned**;
endif

|#F8FAFC|Hệ thống IT-TMS (System & SignalR)|
:Gán AssignedToId & Phát TicketAssignedEvent;
:Lưu CSDL & Ghi vết kiểm toán SystemLog;
:Đẩy WebSocket ReceiveNotification cho Staff và User;

|#FEFCE8|Kỹ thuật viên (Staff)|
:Xem hàng đợi công việc cá nhân (UC13, UC16);
:Bấm bắt đầu tiếp nhận xử lý (UC07);
-> Trạng thái: **InProgress**;

repeat
    if (Cần thêm thông tin từ Người dùng?) then (Cần làm rõ)
        :Tạm dừng xử lý chờ phản hồi (UC07);
        -> Trạng thái: **Waiting**;
        
        |#F8FAFC|Hệ thống IT-TMS (System & SignalR)|
        :Đẩy sự kiện TicketStatusChanged qua SignalR;
        
        |#EFF6FF|Người dùng (User)|
        :Nhận thông báo & Phản hồi qua Chat Real-time (UC06);
        
        |#FEFCE8|Kỹ thuật viên (Staff)|
        :Tiếp nhận phản hồi và tiếp tục xử lý (UC07);
        -> Trạng thái: **InProgress**;
    else (Đủ thông tin)
    endif
    :Thực hiện khắc phục sự cố kỹ thuật;
repeat while (Đã khắc phục triệt để sự cố?) is (Chưa xong)
-> Đã giải quyết xong;

:Cập nhật trạng thái Giải quyết thành công (UC07);
-> Trạng thái: **Resolved**;

|#F8FAFC|Hệ thống IT-TMS (System & SignalR)|
:Ghi nhận ResolvedAt & Khóa tính năng bình luận (CanComment=false);
:Đẩy thông báo nghiệm thu tới Người dùng;

|#EFF6FF|Người dùng (User)|
:Kiểm tra và nghiệm thu kết quả hỗ trợ;
if (Hài lòng với kết quả xử lý?) then (Chưa hài lòng / Lỗi tái diễn)
    :Yêu cầu mở lại xử lý tiếp (UC19)
    (Nhập lý do cần khắc phục lại);
    -> Trạng thái: **InProgress**;
    
    |#FEFCE8|Kỹ thuật viên (Staff)|
    :Tiếp tục hỗ trợ xử lý lại sự cố;
else (Đồng ý nghiệm thu)
    |#EFF6FF|Người dùng (User)|
    :Đóng yêu cầu & Đánh giá 1-5 sao kèm nhận xét (UC04, UC19);
    -> Trạng thái: **Closed**;
    
    |#F8FAFC|Hệ thống IT-TMS (System & SignalR)|
    :Lưu Feedback & ClosedAt vào CSDL;
    :Ghi SystemLog & Đẩy TicketClosedEvent tới Staff qua SignalR;
    
    |#FEFCE8|Kỹ thuật viên (Staff)|
    :Nhận đánh giá sao và lưu vào hồ sơ History (UC14);
    stop
endif
@enduml
