@startuml Hinh5_3_ClassDiagram_MVC
!theme plain
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 10
skinparam roundcorner 6
skinparam linetype ortho

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    HeaderBackgroundColor #F1F5F9
    ArrowColor #2563EB
    BorderThickness 1.2
}

package "Presentation Layer (Controllers, Filters, Hubs)" {
    abstract class BaseController {
        # CurrentUserId : int?
        # CurrentUserName : string?
        # CurrentUserRole : string?
    }

    class AuthController {
        + Login(returnUrl: string) : IActionResult
        + Login(model: LoginViewModel) : Task<IActionResult>
        + Logout() : Task<IActionResult>
        + ChangePassword(model: ChangePasswordViewModel) : Task<IActionResult>
        + AccessDenied() : IActionResult
    }

    class TicketController {
        + Dashboard() : Task<IActionResult>
        + Index(tab: string) : Task<IActionResult>
        + Create() : IActionResult
        + Create(model: CreateTicketViewModel) : Task<IActionResult>
        + Details(id: int) : Task<IActionResult>
        + AddComment(id: int, content: string) : Task<IActionResult>
        + CloseAndRate(model: CloseAndRateViewModel) : Task<IActionResult>
        + Reopen(id: int, reason: string) : Task<IActionResult>
        + DownloadAttachment(id: int) : Task<IActionResult>
    }

    class StaffController {
        + Dashboard() : Task<IActionResult>
        + Assigned(tab: string) : Task<IActionResult>
        + Details(id: int) : Task<IActionResult>
        + StartProgress(id: int) : Task<IActionResult>
        + HoldForInfo(id: int, reason: string) : Task<IActionResult>
        + Resolve(id: int) : Task<IActionResult>
        + AddComment(id: int, content: string, isInternal: bool) : Task<IActionResult>
        + History() : Task<IActionResult>
    }

    class LeaderController {
        + Dashboard() : Task<IActionResult>
        + NewQueue() : Task<IActionResult>
        + Assign(model: AssignTicketViewModel) : Task<IActionResult>
        + Reject(model: RejectTicketViewModel) : Task<IActionResult>
        + Reassign(model: ReassignTicketViewModel) : Task<IActionResult>
        + Index(keyword, statusId, category, staffId) : Task<IActionResult>
        + Details(id: int) : Task<IActionResult>
        + AddComment(id: int, content: string, isInternal: bool) : Task<IActionResult>
    }

    class AdminController {
        + Dashboard() : Task<IActionResult>
        + Users(search, role, status) : Task<IActionResult>
        + CreateUser(model: CreateUserViewModel) : Task<IActionResult>
        + EditUser(model: EditUserViewModel) : Task<IActionResult>
        + ToggleActive(id: int) : Task<IActionResult>
        + ResetPassword(model: ResetPasswordViewModel) : Task<IActionResult>
        + Roles() : Task<IActionResult>
        + Audit(filter) : Task<IActionResult>
    }

    class AuthorizeRolesAttribute <<Decorator / ActionFilter>> {
        - _allowedRoles : string[]
        + OnActionExecutionAsync(context, next) : Task
    }

    class TicketHub <<SignalR WebSocket>> {
        + JoinTicketGroup(ticketId: int) : Task
        + LeaveTicketGroup(ticketId: int) : Task
        + SendComment(ticketId: int, message: string, isInternal: bool) : Task
    }

    BaseController <|-- AuthController
    BaseController <|-- TicketController
    BaseController <|-- StaffController
    BaseController <|-- LeaderController
    BaseController <|-- AdminController
}

package "Domain Layer (Entities & State Pattern)" {
    class User {
        + Id : int
        + Username : string
        + Email : string
        + PasswordHash : string
        + FullName : string
        + Role : UserRole
        + Status : UserStatus
        + IsActive : bool
        + Deactivate(adminId: int) : Result
    }

    class Ticket {
        + Id : int
        + Title : string
        + Priority : TicketPriority
        + Category : TicketCategory
        + StatusId : int
        + DueAt : DateTime
        + ConcurrencyToken : Guid
        + CurrentState : ITicketState
        + Assign(staffId, leaderId) : Result
        + StartProgress(staffId) : Result
        + Resolve(staffId) : Result
        + Close(feedback, user) : Result
        + Reject(reason, leaderId) : Result
    }

    class TicketStatus {
        + Id : int
        + Name : string
        + Label : string
        + ColorClass : string
    }

    class Comment {
        + Id : int
        + TicketId : int
        + UserId : int
        + Content : string
        + IsInternal : bool
    }

    class Feedback {
        + Id : int
        + TicketId : int
        + Rating : int
        + Comment : string
    }

    class Attachment {
        + Id : int
        + TicketId : int
        + FileName : string
        + OriginalFileName : string
        + FileSize : long
    }

    class Notification {
        + Id : int
        + UserId : int
        + Message : string
        + Link : string
        + IsRead : bool
    }

    class SystemLog {
        + Id : int
        + UserId : int?
        + Action : string
        + Details : string
    }

    interface ITicketState {
        + StatusId : int
        + CanComment : bool
        + Assign(...) : Result
        + StartProgress(...) : Result
        + HoldForInfo(...) : Result
        + Resolve(...) : Result
        + Close(...) : Result
        + Reject(...) : Result
    }

    abstract class TicketStateBase implements ITicketState
    class NewState extends TicketStateBase
    class AssignedState extends TicketStateBase
    class InProgressState extends TicketStateBase
    class WaitingState extends TicketStateBase
    class ResolvedState extends TicketStateBase
    class ClosedState extends TicketStateBase
    class RejectedState extends TicketStateBase

    class TicketStateFactory <<Factory Method>> {
        + {static} CreateState(ticket: Ticket, statusId: int) : ITicketState
    }

    Ticket --> ITicketState
    Ticket ..> TicketStateFactory
}

package "Infrastructure & Persistence Layer" {
    interface IItTmsDbContext {
        + Users : DbSet<User>
        + Tickets : DbSet<Ticket>
        + TicketStatuses : DbSet<TicketStatus>
        + Comments : DbSet<Comment>
        + Feedbacks : DbSet<Feedback>
        + Attachments : DbSet<Attachment>
        + Notifications : DbSet<Notification>
        + SystemLogs : DbSet<SystemLog>
        + SaveChangesAsync(cancellationToken) : Task<int>
    }

    class ItTmsDbContext implements IItTmsDbContext {
        - _domainEventDispatcher : IDomainEventDispatcher
        + SaveChangesAsync(cancellationToken) : Task<int>
    }

    interface IDomainEventDispatcher {
        + DispatchInTransactionAsync(events, ct) : Task
        + DispatchPostCommitAsync(events, ct) : Task
    }

    class InMemoryDomainEventDispatcher implements IDomainEventDispatcher

    class NotificationObserver <<Observer>> {
        + HandleAsync(TicketCreatedEvent) : Task
        + HandleAsync(TicketAssignedEvent) : Task
        + HandleAsync(TicketStatusChangedEvent) : Task
    }

    class SystemLogObserver <<Observer>> {
        + HandleAsync(domainEvent) : Task
    }

    class SignalRNotificationDispatcher {
        - _hubContext : IHubContext<TicketHub>
        + HandleCommentAddedAsync(comment) : Task
        + HandleTicketAssignedAsync(assigned) : Task
        + HandleStatusChangedAsync(statusChanged) : Task
    }

    interface IPasswordHasherService {
        + HashPassword(password: string) : string
        + VerifyPassword(password, hash) : bool
    }

    class PasswordHasherService <<Singleton>> implements IPasswordHasherService
}

' Cross-layer Connections
BaseController --> IItTmsDbContext
TicketController --> SignalRNotificationDispatcher
StaffController --> SignalRNotificationDispatcher
LeaderController --> SignalRNotificationDispatcher
AuthController --> IPasswordHasherService
ItTmsDbContext ..> IDomainEventDispatcher : triggers 2-phase
InMemoryDomainEventDispatcher --> NotificationObserver
InMemoryDomainEventDispatcher --> SystemLogObserver
InMemoryDomainEventDispatcher --> SignalRNotificationDispatcher
SignalRNotificationDispatcher --> TicketHub : pushes WebSocket
AuthorizeRolesAttribute ..> IItTmsDbContext : verifies active status

@enduml
