@startuml
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 6

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #334155
    ActorBackgroundColor #EFF6FF
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #FFFFFF
    BoxBorderColor #CBD5E1
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F1F5F9
}

actor "Người dùng\n(User/Client)" as Client
participant "Trình duyệt\n(Browser)" as Browser
participant "AuthController" as Controller #EFF6FF

box "Bảo mật & Dữ liệu CSDL" #FAFAFA
participant "ItTmsDbContext" as DbContext #F1F5F9
participant "PasswordHasherService\n<<Singleton>>" as Hasher #FEFCE8
participant "HttpContext\n(Cookie Auth)" as HttpCtx #EFF6FF
participant "SystemLogs" as SysLog #F1F5F9
end box

Client -> Browser : Nhập thông tin đăng nhập\n(Username, Password, RememberMe)
activate Client

Browser -> Controller : POST /Auth/Login (LoginViewModel)
activate Controller #EFF6FF

Controller -> Controller : Validate ModelState
alt #FEF2F2 ModelState không hợp lệ
    Controller --> Browser : Trả về View(model) kèm lỗi xác thực
    Browser --> Client : Hiển thị lỗi form nhập liệu
end

Controller -> DbContext : Users.FirstOrDefaultAsync(u => u.Username == username || u.Email == username)
activate DbContext #F1F5F9
DbContext --> Controller : user
deactivate DbContext

alt #FEF2F2 Người dùng không tồn tại
    Controller --> Browser : Trả về View(model) kèm lỗi "Sai tên đăng nhập hoặc mật khẩu"
    Browser --> Client : Hiển thị thông báo đăng nhập thất bại
end

Controller -> Hasher : VerifyPassword(user.PasswordHash, model.Password)
activate Hasher #FEFCE8
Hasher --> Controller : isValid (true / false)
deactivate Hasher

alt #FEF2F2 Mật khẩu sai (isValid == false)
    Controller --> Browser : Trả về View(model) kèm lỗi "Sai tên đăng nhập hoặc mật khẩu"
    Browser --> Client : Hiển thị thông báo đăng nhập thất bại
end

alt #FEF2F2 BẢNG 7.2 TC-01: Tài khoản bị vô hiệu hóa (user.Status != Active)
    Controller -> SysLog : SystemLog.Create("Login Denied", "Tài khoản bị vô hiệu hóa", user.Id)
    activate SysLog #F1F5F9
    Controller -> DbContext : SaveChangesAsync()
    activate DbContext #F1F5F9
    DbContext --> Controller : committed
    deactivate DbContext
    deactivate SysLog
    
    Controller --> Browser : Trả về View(model) kèm thông báo "Tài khoản của bạn đã bị vô hiệu hóa"
    Browser --> Client : Hiển thị Floating Card cảnh báo tài khoản Inactive (TC-01)
else #F0FDF4 Xác thực thành công (Active User)
    Controller -> Controller : Tạo ClaimsIdentity (NameIdentifier, Role, Department...)
    Controller -> HttpCtx : SignInAsync(CookieScheme, ClaimsPrincipal, AuthProperties)
    activate HttpCtx #EFF6FF
    HttpCtx --> Controller : Phiên làm việc Cookie thiết lập (Expires: 8h)
    deactivate HttpCtx

    Controller -> SysLog : SystemLog.Create("Login Success", "Đăng nhập thành công", user.Id)
    activate SysLog #F1F5F9
    Controller -> DbContext : SaveChangesAsync()
    activate DbContext #F1F5F9
    DbContext --> Controller : committed
    deactivate DbContext
    deactivate SysLog

    Controller --> Browser : HTTP 302 Redirect to RedirectToRoleDashboard()
    deactivate Controller
    
    Browser --> Client : Điều hướng vào Dashboard tương ứng vai trò (User/Staff/Leader/Admin)
    deactivate Client
end

@enduml
