@startuml
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam packageStyle rectangle

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #334155
    FontColor #0F172A
    FontSize 12
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.2
    ArrowColor #2563EB
    FontColor #0F172A
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #94A3B8
    BorderThickness 1.5
    FontColor #1E293B
    FontSize 13
    FontStyle bold
}

left to right direction

actor "Kỹ thuật viên\n(Staff)" as Staff #F0FDF4

rectangle "Phân hệ Kỹ thuật viên (Staff Subsystem - IT-TMS)" {

    usecase "UC20: Xem Dashboard Kỹ thuật viên\n(KPI cá nhân: vé đang xử lý, chờ thông tin, cảnh báo SLA)" as UC20_Staff
    usecase "Xem hàng đợi công việc cá nhân\n(Assigned Tickets Queue - Lọc theo tab)" as UC_Queue
    
    usecase "UC08: Xem chi tiết yêu cầu được giao\n(View Ticket Details)" as UC08_Staff
    usecase "Kiểm soát an ninh chống BOLA / IDOR\n(Ràng buộc TC-07: Chặn truy cập vé của Staff khác)" as UC_BOLA
    
    usecase "UC07: Cập nhật trạng thái vòng đời Ticket\n(State Pattern Lifecycle Transitions)" as UC07
    usecase "Bắt đầu tiếp nhận xử lý\n(StartProgress: Assigned -> InProgress)" as UC_Start
    usecase "Tạm giữ chờ người dùng phản hồi\n(HoldForInfo: InProgress -> Waiting)" as UC_Hold
    usecase "Khắc phục hoàn tất sự cố\n(Resolve: InProgress/Waiting -> Resolved)" as UC_Resolve
    usecase "Kiểm tra tính hợp lệ của chuyển đổi\n(Ràng buộc TC-05: Chặn thao tác sai trạng thái)" as UC_ValidateState

    usecase "UC06: Trao đổi thông tin & Ghi chú kỹ thuật\n(Realtime Discussion & Internal Notes)" as UC06_Staff
    usecase "Ghi chú nội bộ kỹ thuật\n(IsInternal = true - ẩn tuyệt đối với User)" as UC_InternalNote
    usecase "Kiểm tra quyền gửi bình luận\n(Ràng buộc TC-08: Chặn bình luận nếu Resolved/Closed)" as UC_CanComment

    usecase "UC16: Xem lịch sử hỗ trợ & Đánh giá\n(Processing History & Feedback 1-5 sao)" as UC16

    package "Mẫu thiết kế Hướng đối tượng hỗ trợ" #F1F5F9 {
        usecase "Thực thi mẫu State Pattern\n(ITicketState, TicketStateBase & 7 States)" as UC_State
        usecase "Phát thông báo SignalR & Ghi SystemLog\n(Observer Pattern: Notification & SystemLog)" as UC_Observer
    }
}

Staff --> UC20_Staff
Staff --> UC_Queue
Staff --> UC08_Staff
Staff --> UC07
Staff --> UC06_Staff
Staff --> UC16

' Quan hệ Include & Extend
UC_Queue ..> UC08_Staff : <<extend>>
UC08_Staff ..> UC_BOLA : <<include>>

UC07 ..> UC_Start : <<extend>>
UC07 ..> UC_Hold : <<extend>>
UC07 ..> UC_Resolve : <<extend>>
UC07 ..> UC_ValidateState : <<include>>
UC07 ..> UC_State : <<include>>
UC07 ..> UC_Observer : <<include>>

UC06_Staff ..> UC_InternalNote : <<extend>>
UC06_Staff ..> UC_CanComment : <<include>>
UC06_Staff ..> UC_Observer : <<include>>

UC_Resolve ..> UC_Observer : <<include>>

@enduml
