@startuml Hinh3_1_ERD_8Bang
!theme plain
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 6
skinparam linetype ortho

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #334155
    HeaderBackgroundColor #F1F5F9
    ArrowColor #2563EB
    BorderThickness 1.2
}

entity "Users" as users {
    * **Id** : int [PK, Identity]
    --
    * Username : nvarchar(80) [UQ, Index]
    * Email : nvarchar(150) [UQ, Index]
    * PasswordHash : nvarchar(255)
    * FullName : nvarchar(120)
    * Role : nvarchar(20) [Admin, Leader, Staff, User]
    * Status : nvarchar(20) [Active, Inactive]
    Department : nvarchar(100) [Nullable]
    * CreatedAt : datetime2 [UTC]
    UpdatedAt : datetime2 [UTC, Nullable]
}

entity "TicketStatuses" as statuses {
    * **Id** : int [PK, 1..7]
    --
    * Name : nvarchar(50) [UQ, Index]
    * Label : nvarchar(100)
    * ColorClass : nvarchar(100)
    * SortOrder : int
    Description : nvarchar(255) [Nullable]
}

entity "Tickets" as tickets {
    * **Id** : int [PK, Identity]
    --
    * Title : nvarchar(150)
    * Description : ntext
    * Priority : nvarchar(20) [Low, Medium, High, Critical]
    * Category : nvarchar(50) [Hardware, Software, Network, Account, Other]
    * CreatorId : int [FK -> Users.Id, Restrict]
    AssignedToId : int? [FK -> Users.Id, SetNull]
    * StatusId : int [FK -> TicketStatuses.Id, Restrict]
    * DueAt : datetime2 [UTC, SLA]
    ResolvedAt : datetime2 [UTC, Nullable]
    ClosedAt : datetime2 [UTC, Nullable]
    RejectionReason : nvarchar(500) [Nullable]
    * CreatedAt : datetime2 [UTC]
    * UpdatedAt : datetime2 [UTC]
    * ConcurrencyToken : uniqueidentifier [Guid]
}

entity "Comments" as comments {
    * **Id** : int [PK, Identity]
    --
    * TicketId : int [FK -> Tickets.Id, Cascade]
    * UserId : int [FK -> Users.Id, Restrict]
    * Content : ntext
    * IsInternal : bit [0=Public, 1=Internal]
    * CreatedAt : datetime2 [UTC]
}

entity "Feedbacks" as feedbacks {
    * **Id** : int [PK, Identity]
    --
    * TicketId : int [FK -> Tickets.Id, UQ (1:1), Cascade]
    * Rating : int [1..5 Stars]
    Comment : nvarchar(1000) [Nullable]
    * CreatedAt : datetime2 [UTC]
}

entity "Attachments" as attachments {
    * **Id** : int [PK, Identity]
    --
    * TicketId : int [FK -> Tickets.Id, Cascade]
    * FileName : nvarchar(255) [Physical Guid]
    * OriginalFileName : nvarchar(255)
    * ContentType : nvarchar(100) [MIME]
    * FileSize : bigint [Bytes, Max 16MB]
    * CreatedAt : datetime2 [UTC]
}

entity "Notifications" as notifications {
    * **Id** : int [PK, Identity]
    --
    * UserId : int [FK -> Users.Id, Cascade]
    * Message : nvarchar(255)
    * Link : nvarchar(255)
    * IsRead : bit [Default 0]
    * CreatedAt : datetime2 [UTC]
}

entity "SystemLogs" as logs {
    * **Id** : int [PK, Identity]
    --
    UserId : int? [FK -> Users.Id, SetNull]
    * Action : nvarchar(50)
    * Details : ntext [Audit Trail]
    IpAddress : nvarchar(50) [Nullable]
    * CreatedAt : datetime2 [UTC]
}

' Relationships & Multiplicities
users ||--o{ tickets : "creates\n(1..*)"
users ||--o{ tickets : "assigned_to\n(0..*)"
statuses ||--o{ tickets : "classifies\n(1..*)"
tickets ||--o{ comments : "has\n(0..*)"
users ||--o{ comments : "authors\n(1..*)"
tickets ||--o| feedbacks : "evaluated_by\n(0..1)"
tickets ||--o{ attachments : "attaches\n(0..*)"
users ||--o{ notifications : "receives\n(1..*)"
users ||--o{ logs : "performs\n(0..*)"

@enduml
