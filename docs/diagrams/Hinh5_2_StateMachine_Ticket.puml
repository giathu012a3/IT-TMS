@startuml Hinh5_2_StateMachine_Ticket
!theme plain
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 8

skinparam state {
    BackgroundColor #FFFFFF
    BorderColor #334155
    ArrowColor #2563EB
    StartColor #0F172A
    EndColor #0F172A
    BorderThickness 1.2
    FontSize 11
}

[*] --> New : [UC03] User gửi yêu cầu\n/ CalculateDueAt(Priority), emit TicketCreatedEvent

state "New (Mới tạo)\n--\nStatusId = 1\nCanComment = true\nentry / Khởi tạo SLA DueAt" as New #F8FAFC
state "Assigned (Đã phân công)\n--\nStatusId = 2\nCanComment = true\nentry / Gán AssignedToId, emit TicketAssignedEvent" as Assigned #EFF6FF
state "InProgress (Đang xử lý)\n--\nStatusId = 3\nCanComment = true\nentry / KTV bắt đầu khắc phục sự cố" as InProgress #F0FDF4
state "Waiting (Chờ phản hồi)\n--\nStatusId = 4\nCanComment = true\nentry / Tạm dừng chờ User bổ sung thông tin" as Waiting #FEFCE8
state "Resolved (Đã giải quyết)\n--\nStatusId = 5\nCanComment = false [TC-08]\nentry / Ghi nhận ResolvedAt, khóa gửi bình luận" as Resolved #FAF5FF
state "Closed (Đã đóng) <<Terminal>>\n--\nStatusId = 6\nCanComment = false\nentry / Ghi nhận ClosedAt, lưu Feedback 1-5 sao" as Closed #F1F5F9
state "Rejected (Đã từ chối) <<Terminal>>\n--\nStatusId = 7\nCanComment = false\nentry / Ghi nhận RejectionReason" as Rejected #FEF2F2

New --> Assigned : [UC09] Leader.Assign(staffId)\n[staff.IsActive && staff.Role == Staff]\n/ emit TicketAssignedEvent
New --> Rejected : [UC10] Leader.Reject(reason)\n[!string.IsNullOrWhiteSpace(reason)]\n/ Gán RejectionReason

Assigned --> InProgress : [UC07] Staff.StartProgress()\n[staffId == AssignedToId]\n/ UpdatedAt = UtcNow
Assigned --> Assigned : [UC09] Leader.Reassign(newStaffId)\n[newStaff.IsActive]\n/ Điều chuyển KTV phụ trách

InProgress --> Waiting : [UC07] Staff.HoldForInfo(reason)\n/ Chuyển sang chờ phản hồi
Waiting --> InProgress : [UC06, UC07] User phản hồi hoặc Staff.StartProgress()\n/ Tiếp tục xử lý
InProgress --> InProgress : [UC09] Leader.Reassign(newStaffId)\n/ Điều chuyển KTV
Waiting --> Waiting : [UC09] Leader.Reassign(newStaffId)\n/ Điều chuyển KTV

InProgress --> Resolved : [UC07] Staff.Resolve()\n[staffId == AssignedToId]\n/ ResolvedAt = UtcNow, CanComment = false
Waiting --> Resolved : [UC07] Staff.Resolve()\n/ ResolvedAt = UtcNow, CanComment = false

Resolved --> Closed : [UC04, UC19] User.CloseAndRate(rating, comment)\n[rating in 1..5]\n/ Lưu Feedback, ClosedAt = UtcNow
Resolved --> InProgress : [UC19] User.Reopen(reason)\n[!string.IsNullOrWhiteSpace(reason)]\n/ Mở lại xử lý vì sự cố chưa dứt điểm

Closed --> [*] : Hoàn tất vòng đời
Rejected --> [*] : Kết thúc vòng đời

note right of InProgress
  **Ràng buộc bất biến (Invariants):**
  - **TC-06**: Leader.Reject() trên InProgress
    bị chặn đứng: ""CannotRejectInProgress"".
  - **TC-07**: Chỉ KTV được gán mới có quyền
    thao tác chuyển trạng thái (BOLA Protection).
end note

note right of Resolved
  **Quy tắc an ninh & nghiệp vụ:**
  - **TC-08**: ""CanComment = false""
    Khóa gửi bình luận trên Resolved, Closed, Rejected.
  - **TC-05**: Chuyển trạng thái sai quy trình
    bị Fail-Closed chặn đứng (Result.Failure).
end note

@enduml
