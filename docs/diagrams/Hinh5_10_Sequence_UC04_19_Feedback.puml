@startuml
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 6

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #334155
    ActorBackgroundColor #EFF6FF
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #FFFFFF
    BoxBorderColor #CBD5E1
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F1F5F9
}

actor "Người dùng\n(User)" as User #EFF6FF
participant "TicketController" as Controller #EFF6FF

box "Tầng Dữ liệu CSDL" #FAFAFA
participant "ItTmsDbContext" as DbContext #F1F5F9
end box

box "Mẫu State & Thực thể Đánh giá" #FAFAFA
participant "Ticket\n<<Context>>" as Ticket #EFF6FF
participant "ResolvedState\n<<State>>" as ResolvedState #FAF5FF
participant "ClosedState\n<<TerminalState>>" as ClosedState #F1F5F9
participant "Feedback\n<<Entity>>" as Feedback #FEFCE8
end box

box "Điều phối Sự kiện & SignalR" #FAFAFA
participant "DomainEventDispatcher" as Dispatcher #FEFCE8
participant "TicketHub\n<<SignalR Hub>>" as Hub #EFF6FF
end box

actor "Kỹ thuật viên\n(Staff)" as Staff #F0FDF4

User -> Controller : POST /Ticket/CloseAndRate (TicketId, Rating: 1-5 sao, Comment)
activate User
activate Controller #EFF6FF

Controller -> Controller : Validate ModelState (Rating từ 1 đến 5 sao)
Controller -> DbContext : Tickets.Include(Status).FirstOrDefaultAsync(TicketId)
activate DbContext #F1F5F9
DbContext --> Controller : ticket
deactivate DbContext

alt #FEF2F2 Chặn BOLA: Người dùng không phải là người tạo ticket
    Controller --> User : HTTP 403 Forbidden
end

' BẢNG 7.2 TC-09: Khởi tạo Feedback và gọi đóng ticket qua State Pattern
Controller -> Feedback : Feedback.Create(ticketId, rating, comment)
activate Feedback #FEFCE8
Feedback --> Controller : Result<Feedback>.Success(feedback)
deactivate Feedback

Controller -> Ticket : Close(feedback)
activate Ticket #EFF6FF

Ticket -> ResolvedState : Close(ticket, feedback)
activate ResolvedState #FAF5FF

ResolvedState -> ClosedState : TransitionTo(ClosedState)
ResolvedState -> Ticket : Gán StatusId = 6 (Closed), ClosedAt = UtcNow
ResolvedState -> Ticket : AddDomainEvent(new TicketClosedEvent(ticket, feedback))
ResolvedState --> Ticket : Result.Success()
deactivate ResolvedState

Ticket --> Controller : Result.Success()
deactivate Ticket

Controller -> DbContext : Feedbacks.AddAsync(feedback)
Controller -> DbContext : SystemLogs.Add("Ticket Closed & Rated", "Đóng kèm đánh giá " + rating + " sao")
Controller -> DbContext : SaveChangesAsync()
activate DbContext #F1F5F9

DbContext -> Dispatcher : DispatchInTransactionAsync(TicketClosedEvent)
activate Dispatcher #FEFCE8
Dispatcher -> DbContext : Notifications.Add(Tạo thông báo điểm đánh giá sao cho Staff)
deactivate Dispatcher

DbContext -> DbContext : SQLite Commit

DbContext -> Dispatcher : DispatchPostCommitAsync(TicketClosedEvent)
activate Dispatcher #FEFCE8

Dispatcher -> Hub : Clients.Group("ticket_{id}").SendAsync("TicketStatusChanged", statusDto)
activate Hub #EFF6FF
Hub --> User : WebSocket Broadcast: Cập nhật nhãn "Đã đóng" & Khóa ô chat
deactivate Hub

Dispatcher -> Hub : Clients.User(staffId).SendAsync("ReceiveNotification", notifDto)
activate Hub #EFF6FF
Hub --> Staff : WebSocket Push: Floating Card thông báo khách hàng đã nghiệm thu & đánh giá sao (TC-09)
deactivate Hub
deactivate Dispatcher

DbContext --> Controller : rowsAffected > 0
deactivate DbContext

Controller --> User : RedirectToAction("Details", new { id = ticket.Id }) kèm thông báo cảm ơn
deactivate Controller
deactivate User

@enduml
