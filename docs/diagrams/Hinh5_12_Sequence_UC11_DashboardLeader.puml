@startuml
skinparam dpi 300
skinparam monochrome false
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundcorner 6

skinparam sequence {
    ArrowColor #2563EB
    ActorBorderColor #334155
    ActorBackgroundColor #EFF6FF
    LifeLineBorderColor #64748B
    LifeLineBackgroundColor #F8FAFC
    ParticipantBorderColor #334155
    ParticipantBackgroundColor #FFFFFF
    BoxBorderColor #CBD5E1
    BoxBackgroundColor #F8FAFC
    GroupBorderColor #94A3B8
    GroupBackgroundColor #F1F5F9
}

actor "Trưởng nhóm\n(Leader)" as Leader #FEFCE8

box "Mẫu Decorator & Bộ điều khiển" #FAFAFA
participant "AuthorizeRolesAttribute\n<<GoF Decorator>>" as Filter #FEFCE8
participant "LeaderController" as Controller #EFF6FF
end box

box "Tầng Dữ liệu CSDL EF Core 9" #FAFAFA
participant "ItTmsDbContext" as DbContext #F1F5F9
end box

box "Xử lý Thống kê & Tổng hợp KPI" #FAFAFA
participant "LINQ Aggregator" as Aggregator #FEFCE8
participant "LeaderDashboardViewModel" as ViewModel #EFF6FF
end box

participant "Leader/Dashboard.cshtml\n(Razor View UI)" as ViewUI #F8FAFC

Leader -> Controller : GET /Leader/Dashboard
activate Leader
activate Controller #EFF6FF

Controller -> Filter : OnActionExecutionAsync(context)
activate Filter #FEFCE8
Filter --> Controller : Next() - Xác thực phân quyền Leader hợp lệ
deactivate Filter

' Tải danh sách ticket bất đồng bộ
Controller -> DbContext : Tickets.AsNoTracking().Include(Status).Include(AssignedTo).ToListAsync()
activate DbContext #F1F5F9
DbContext --> Controller : allTickets
deactivate DbContext

Controller -> DbContext : Users.AsNoTracking().Where(Role == Staff && Status == Active).ToListAsync()
activate DbContext #F1F5F9
DbContext --> Controller : staffUsers
deactivate DbContext

' Tổng hợp chỉ số KPI
Controller -> Aggregator : Đếm số lượng ticket theo trạng thái
activate Aggregator #FEFCE8
Aggregator -> Aggregator : newCount = Count(Status == New)
Aggregator -> Aggregator : inProgressCount = Count(Status == InProgress || Waiting)
Aggregator -> Aggregator : resolvedCount = Count(Status == Resolved)
Aggregator -> Aggregator : Tính breachedSlaCount & tỷ lệ tuân thủ slaComplianceRate
Aggregator -> Aggregator : Phân bổ khối lượng công việc nhân viên (staffWorkloads)
Aggregator -> Aggregator : Phân bổ danh mục sự cố (categoryDistribution)
Aggregator -> Aggregator : Lấy 10 yêu cầu ưu tiên khẩn cấp nhất (urgentTickets)
Aggregator --> Controller : Kết quả tổng hợp chỉ số nghiệp vụ
deactivate Aggregator

Controller -> ViewModel : new LeaderDashboardViewModel(...)
activate ViewModel #EFF6FF
ViewModel --> Controller : model
deactivate ViewModel

Controller -> ViewUI : View(model)
activate ViewUI #F8FAFC
ViewUI --> Leader : Hiển thị Dashboard chỉ huy: KPI vé mới, đang xử lý, đã giải quyết, cảnh báo vi phạm SLA
deactivate ViewUI
deactivate Controller
deactivate Leader

@enduml
