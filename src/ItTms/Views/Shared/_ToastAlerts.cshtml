@* Multi-tier Top-Floating Toast Notification System (Modern Floating Island / Stack) *@
<div id="toast-container" class="floating-notification-stack" role="region" aria-label="Thông báo hệ thống">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="floating-card-box floating-card-success" role="alert" aria-live="assertive">
            <div class="floating-card-inner">
                <div class="floating-card-icon-box">
                    <svg class="bi" width="18" height="18"><use xlink:href="#check-circle-fill"/></svg>
                </div>
                <div class="floating-card-content">
                    <div class="floating-card-title">Thành công</div>
                    <div class="floating-card-message">@TempData["SuccessMessage"]</div>
                </div>
                <button type="button" class="floating-card-close" aria-label="Đóng" onclick="window.dismissToastCard ? window.dismissToastCard(this.closest('.floating-card-box')) : this.closest('.floating-card-box').remove()">
                    <svg class="bi" width="14" height="14"><use xlink:href="#x-circle-fill"/></svg>
                </button>
            </div>
            <div class="floating-card-progress">
                <div class="floating-card-progress-bar"></div>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="floating-card-box floating-card-error" role="alert" aria-live="assertive">
            <div class="floating-card-inner">
                <div class="floating-card-icon-box">
                    <svg class="bi" width="18" height="18"><use xlink:href="#x-circle-fill"/></svg>
                </div>
                <div class="floating-card-content">
                    <div class="floating-card-title">Thông báo lỗi</div>
                    <div class="floating-card-message">@TempData["ErrorMessage"]</div>
                </div>
                <button type="button" class="floating-card-close" aria-label="Đóng" onclick="window.dismissToastCard ? window.dismissToastCard(this.closest('.floating-card-box')) : this.closest('.floating-card-box').remove()">
                    <svg class="bi" width="14" height="14"><use xlink:href="#x-circle-fill"/></svg>
                </button>
            </div>
            <div class="floating-card-progress">
                <div class="floating-card-progress-bar"></div>
            </div>
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        <div class="floating-card-box floating-card-warning" role="alert" aria-live="assertive">
            <div class="floating-card-inner">
                <div class="floating-card-icon-box">
                    <svg class="bi" width="18" height="18"><use xlink:href="#exclamation-triangle-fill"/></svg>
                </div>
                <div class="floating-card-content">
                    <div class="floating-card-title">Lưu ý</div>
                    <div class="floating-card-message">@TempData["WarningMessage"]</div>
                </div>
                <button type="button" class="floating-card-close" aria-label="Đóng" onclick="window.dismissToastCard ? window.dismissToastCard(this.closest('.floating-card-box')) : this.closest('.floating-card-box').remove()">
                    <svg class="bi" width="14" height="14"><use xlink:href="#x-circle-fill"/></svg>
                </button>
            </div>
            <div class="floating-card-progress">
                <div class="floating-card-progress-bar"></div>
            </div>
        </div>
    }

    @if (TempData["InfoMessage"] != null)
    {
        <div class="floating-card-box floating-card-info" role="alert" aria-live="assertive">
            <div class="floating-card-inner">
                <div class="floating-card-icon-box">
                    <svg class="bi" width="18" height="18"><use xlink:href="#info-circle-fill"/></svg>
                </div>
                <div class="floating-card-content">
                    <div class="floating-card-title">Thông tin</div>
                    <div class="floating-card-message">@TempData["InfoMessage"]</div>
                </div>
                <button type="button" class="floating-card-close" aria-label="Đóng" onclick="window.dismissToastCard ? window.dismissToastCard(this.closest('.floating-card-box')) : this.closest('.floating-card-box').remove()">
                    <svg class="bi" width="14" height="14"><use xlink:href="#x-circle-fill"/></svg>
                </button>
            </div>
            <div class="floating-card-progress">
                <div class="floating-card-progress-bar"></div>
            </div>
        </div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        @foreach (var err in ViewData.ModelState[string.Empty]!.Errors)
        {
            <div class="floating-card-box floating-card-error" role="alert" aria-live="assertive">
                <div class="floating-card-inner">
                    <div class="floating-card-icon-box">
                        <svg class="bi" width="18" height="18"><use xlink:href="#exclamation-triangle-fill"/></svg>
                    </div>
                    <div class="floating-card-content">
                        <div class="floating-card-title">Thông báo lỗi</div>
                        <div class="floating-card-message">@err.ErrorMessage</div>
                    </div>
                    <button type="button" class="floating-card-close" aria-label="Đóng" onclick="window.dismissToastCard ? window.dismissToastCard(this.closest('.floating-card-box')) : this.closest('.floating-card-box').remove()">
                        <svg class="bi" width="14" height="14"><use xlink:href="#x-circle-fill"/></svg>
                    </button>
                </div>
                <div class="floating-card-progress">
                    <div class="floating-card-progress-bar"></div>
                </div>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(Context.Request.Query["error"]))
    {
        <div class="floating-card-box floating-card-error" role="alert" aria-live="assertive">
            <div class="floating-card-inner">
                <div class="floating-card-icon-box">
                    <svg class="bi" width="18" height="18"><use xlink:href="#lock-fill"/></svg>
                </div>
                <div class="floating-card-content">
                    <div class="floating-card-title">Bảo mật</div>
                    <div class="floating-card-message">@Context.Request.Query["error"]</div>
                </div>
                <button type="button" class="floating-card-close" aria-label="Đóng" onclick="window.dismissToastCard ? window.dismissToastCard(this.closest('.floating-card-box')) : this.closest('.floating-card-box').remove()">
                    <svg class="bi" width="14" height="14"><use xlink:href="#x-circle-fill"/></svg>
                </button>
            </div>
            <div class="floating-card-progress">
                <div class="floating-card-progress-bar"></div>
            </div>
        </div>
    }
</div>

<script>
(function() {
    function initToastProgress() {
        document.querySelectorAll("#toast-container .floating-card-box").forEach(function(card) {
            if (card.dataset.progressBound) return;
            card.dataset.progressBound = "true";
            var bar = card.querySelector(".floating-card-progress-bar");
            if (bar) {
                bar.addEventListener("animationend", function() {
                    if (typeof window.dismissToastCard === "function") {
                        window.dismissToastCard(card);
                    } else {
                        card.classList.add("is-dismissing");
                        setTimeout(function() { card.remove(); }, 220);
                    }
                });
            }
        });
    }
    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initToastProgress);
    } else {
        initToastProgress();
    }
})();
</script>
