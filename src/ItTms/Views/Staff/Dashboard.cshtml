@model StaffDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Dashboard</h3>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Assigned" asp-controller="Staff" class="btn btn-primary rounded-3 shadow-sm">
            <svg class="bi me-1" width="16" height="16"><use xlink:href="#ticket-perforated"/></svg>
            Xem Hàng đợi Được giao
        </a>
    </div>
</div>

<!-- DẢI CHỈ SỐ CÔNG VIỆC -->
<section class="kpis mb-4">
    <div class="kpi">
        <div class="kpi-label">
            <span>Chờ tiếp nhận</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#ticket-perforated"/></svg>
        </div>
        <div class="kpi-value">@Model.AssignedCount</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Đang xử lý</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#speedometer2"/></svg>
        </div>
        <div class="kpi-value warn">@Model.InProgressCount</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Chờ phản hồi</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#clock"/></svg>
        </div>
        <div class="kpi-value">@Model.WaitingCount</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Hoàn thành hôm nay</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#check-circle-fill"/></svg>
        </div>
        <div class="kpi-value pos">@Model.ResolvedTodayCount</div>
    </div>
</section>

<!-- CANH BÁO KHẨN CẤP SLA -->
@if (Model.UrgentSlaTickets.Count > 0)
{
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-body border-start border-danger border-4">
        <div class="card-header bg-transparent border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0 d-flex align-items-center">
                <svg class="bi me-2" width="20" height="20"><use xlink:href="#exclamation-triangle-fill"/></svg>
                Yêu cầu Ưu tiên / Cận hạn SLA cần xử lý ngay
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th class="ps-4">Mã số</th>
                            <th>Tiêu đề</th>
                            <th>Ưu tiên</th>
                            <th>Trạng thái</th>
                            <th>Người tạo</th>
                            <th>Hạn cam kết SLA</th>
                            <th class="pe-4 text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.UrgentSlaTickets)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@ticket.Id</td>
                                <td class="fw-semibold">@ticket.Title</td>
                                <td>
                                    <span class="badge @(ticket.Priority == TicketPriority.Critical ? "bg-danger" : ticket.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td><span class="badge @ticket.StatusColorClass">@ticket.StatusLabel</span></td>
                                <td>@ticket.CreatorName</td>
                                <td>@await Html.PartialAsync("_SlaBadge", (ticket.DueAt, ticket.StatusId, ticket.ResolvedAt))</td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-controller="Staff" asp-route-id="@ticket.Id" class="btn btn-sm btn-danger shadow-sm">
                                        Xử lý ngay
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- DANH SÁCH CÔNG VIỆC ĐANG ĐẢM NHIỆM -->
<div class="card border-0 shadow-sm rounded-4 bg-body">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Danh sách công việc đang đảm nhiệm</h5>
        <a asp-action="Assigned" asp-controller="Staff" class="small text-decoration-none">Xem toàn bộ &rarr;</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Mã số</th>
                        <th>Tiêu đề</th>
                        <th>Danh mục</th>
                        <th>Ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Hạn SLA</th>
                        <th class="pe-4 text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ActiveTickets.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Hiện không có yêu cầu nào đang chờ xử lý.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model.ActiveTickets)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@ticket.Id</td>
                                <td>
                                    <a asp-action="Details" asp-controller="Staff" asp-route-id="@ticket.Id" class="text-decoration-none fw-semibold text-body">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-body border">@ticket.Category</span></td>
                                <td>
                                    <span class="badge @(ticket.Priority == TicketPriority.Critical ? "bg-danger" : ticket.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td><span class="badge @ticket.StatusColorClass">@ticket.StatusLabel</span></td>
                                <td>@await Html.PartialAsync("_SlaBadge", (ticket.DueAt, ticket.StatusId, ticket.ResolvedAt))</td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-controller="Staff" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-secondary">
                                        Tiếp tục xử lý
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
