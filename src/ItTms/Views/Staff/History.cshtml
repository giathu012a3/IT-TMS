@model List<TicketListItemViewModel>
@{
    ViewData["Title"] = "Lịch sử xử lý";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Lịch sử sự cố đã xử lý</h3>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-body">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Mã vé</th>
                        <th>Tiêu đề sự cố</th>
                        <th>Người tạo</th>
                        <th>Ưu tiên</th>
                        <th>Thời gian giải quyết</th>
                        <th>Đánh giá dịch vụ</th>
                        <th class="pe-4 text-end">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Chưa có sự cố nào được giải quyết trong lịch sử.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@ticket.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="fw-semibold text-body text-decoration-none">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td>@ticket.CreatorName</td>
                                <td>
                                    <span class="badge @(ticket.Priority == TicketPriority.Critical ? "bg-danger" : ticket.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td>
                                    @if (ticket.ResolvedAt.HasValue)
                                    {
                                        <span>@ticket.ResolvedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td>
                                    @if (ticket.FeedbackRating.HasValue)
                                    {
                                        <span class="text-warning">
                                            @for (int i = 1; i <= ticket.FeedbackRating.Value; i++)
                                            {
                                                <svg class="bi" width="16" height="16"><use xlink:href="#star-fill"/></svg>
                                            }
                                        </span>
                                        <span class="fw-bold small ms-1">(@ticket.FeedbackRating.Value/5)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-muted">Chưa đánh giá</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-secondary">
                                        Xem lại
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
