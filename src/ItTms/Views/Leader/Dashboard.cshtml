@model LeaderDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Dashboard</h3>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="NewQueue" asp-controller="Leader" class="btn btn-primary position-relative">
            <svg class="bi me-1" width="15" height="15"><use xlink:href="#ticket-perforated"/></svg>
            Hàng đợi Tiếp nhận & Phân công
            @if (Model.NewCount > 0)
            {
                <span class="badge badge-sla-overdue ms-1">@Model.NewCount</span>
            }
        </a>
    </div>
</div>

<!-- DẢI CHỈ SỐ SLA & TIẾN ĐỘ -->
<section class="kpis mb-4">
    <div class="kpi">
        <div class="kpi-label">
            <span>Chờ tiếp nhận</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#exclamation-triangle-fill"/></svg>
        </div>
        <div class="kpi-value @(Model.NewCount > 0 ? "neg" : "")">@Model.NewCount</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Đang giải quyết</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#speedometer2"/></svg>
        </div>
        <div class="kpi-value">@Model.InProgressCount</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Đã hoàn thành</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#check-circle-fill"/></svg>
        </div>
        <div class="kpi-value pos">@Model.ResolvedCount</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Tỷ lệ đúng hạn SLA</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#shield-check"/></svg>
        </div>
        <div class="kpi-value">@Model.SlaComplianceRate%</div>
    </div>
</section>

<div class="row g-4 mb-4">
    <!-- CÂN BẰNG TẢI KỸ THUẬT VIÊN (STAFF WORKLOAD) -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header pt-4 px-4 pb-2">
                <h5 class="fw-bold mb-1">Cân bằng Tải Công việc Kỹ thuật viên</h5>
                <span class="text-muted small">Khối lượng công việc đang xử lý của từng nhân sự</span>
            </div>
            <div class="card-body px-4">
                @if (Model.StaffWorkloads.Count == 0)
                {
                    <p class="text-muted small py-4 text-center">Chưa có nhân sự kỹ thuật viên nào đang hoạt động.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var staff in Model.StaffWorkloads)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-3">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-circle me-3">
                                        @(staff.StaffName.Length > 0 ? staff.StaffName.Substring(0, 1).ToUpperInvariant() : "S")
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@staff.StaffName</div>
                                        <div class="text-muted small">@staff.Email</div>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <span class="badge @(staff.ActiveTicketsCount > 4 ? "bg-danger" : staff.ActiveTicketsCount > 2 ? "bg-warning" : "bg-secondary-subtle")">
                                        @staff.ActiveTicketsCount việc đang làm
                                    </span>
                                    <div class="text-muted small mt-1 num">Đã xong: @staff.ResolvedTicketsCount</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- PHÂN BỔ SỰ CỐ THEO DANH MỤC -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header pt-4 px-4 pb-2">
                <h5 class="fw-bold mb-1">Phân bổ Sự cố theo Danh mục</h5>
                <span class="text-muted small">Cơ cấu loại yêu cầu trên toàn hệ thống</span>
            </div>
            <div class="card-body px-4">
                <div class="list-group list-group-flush">
                    @foreach (var kvp in Model.CategoryDistribution)
                    {
                        var catName = kvp.Key switch
                        {
                            TicketCategory.Hardware => "Phần cứng",
                            TicketCategory.Software => "Phần mềm",
                            TicketCategory.Network => "Mạng & Kết nối",
                            TicketCategory.Account => "Tài khoản & Phân quyền",
                            _ => "Khác"
                        };

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                            <span>@catName</span>
                            <span class="badge bg-secondary-subtle num">@kvp.Value yêu cầu</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- DANH SÁCH YÊU CẦU CẬN HẠN / QUÁ HẠN SLA CẦN LƯU Ý -->
<div class="card">
    <div class="card-header pt-4 px-4 pb-3 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Yêu cầu Ưu tiên / Đang tiếp diễn</h5>
        <a asp-action="Index" asp-controller="Leader" class="small text-decoration-none link-primary fw-medium">Xem toàn bộ hệ thống &rarr;</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Mã số</th>
                        <th>Tiêu đề sự cố</th>
                        <th>Người tạo</th>
                        <th>Mức ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Kỹ thuật viên phụ trách</th>
                        <th>Hạn cam kết SLA</th>
                        <th class="pe-4 text-end">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.UrgentTickets.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Hiện không có yêu cầu nào đang tồn đọng.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in Model.UrgentTickets)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@t.Id</td>
                                <td class="fw-semibold">@t.Title</td>
                                <td>@t.CreatorName</td>
                                <td>
                                    <span class="badge @(t.Priority == TicketPriority.Critical ? "bg-danger" : t.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @t.Priority
                                    </span>
                                </td>
                                <td><span class="badge @t.StatusColorClass">@t.StatusLabel</span></td>
                                <td>@(t.AssignedToName ?? "Chưa phân công")</td>
                                <td>@await Html.PartialAsync("_SlaBadge", (t.DueAt, t.StatusId, t.ResolvedAt))</td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-controller="Leader" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">
                                        Giám sát
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
