@model List<TicketListItemViewModel>
@{
    ViewData["Title"] = "Hàng đợi tiếp nhận";
    var staffList = ViewBag.StaffList as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0 d-flex align-items-center">
            <svg class="bi me-2 text-muted" width="22" height="22"><use xlink:href="#ticket-perforated"/></svg>
            Hàng đợi tiếp nhận
        </h3>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-body">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Mã số</th>
                        <th>Tiêu đề sự cố</th>
                        <th>Người tạo</th>
                        <th>Danh mục</th>
                        <th>Ưu tiên</th>
                        <th>Thời điểm tạo</th>
                        <th>Hạn cam kết SLA</th>
                        <th class="pe-4 text-end">Hành động điều phối</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <svg class="bi text-success mb-2" width="36" height="36"><use xlink:href="#check-circle-fill"/></svg><br/>
                                Hiện tại không có yêu cầu nào trong hàng đợi tiếp nhận.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@ticket.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="fw-semibold text-body text-decoration-none">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td>@ticket.CreatorName</td>
                                <td><span class="badge bg-secondary-subtle">@ticket.Category</span></td>
                                <td>
                                    <span class="badge @(ticket.Priority == TicketPriority.Critical ? "bg-danger" : ticket.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td>@ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@await Html.PartialAsync("_SlaBadge", (ticket.DueAt, ticket.StatusId, ticket.ResolvedAt))</td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        <button type="button" class="btn btn-sm btn-primary shadow-sm" 
                                                data-bs-toggle="modal" data-bs-target="#assignModal" 
                                                data-ticket-id="@ticket.Id" data-ticket-title="@ticket.Title">
                                            Phân công
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" 
                                                data-bs-toggle="modal" data-bs-target="#rejectModal" 
                                                data-ticket-id="@ticket.Id" data-ticket-title="@ticket.Title">
                                            Từ chối
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL PHÂN CÔNG TICKET (BẢNG 7.2 TC-04) -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="assignModalLabel">Phân công Kỹ thuật viên Tiếp nhận</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Assign" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="assignTicketId" name="TicketId" value="" />
                <div class="modal-body py-4">
                    <p class="small text-muted mb-3">
                        Giao yêu cầu <strong id="assignTicketTitle" class="text-body">#--</strong> cho kỹ thuật viên phụ trách:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Chọn Kỹ thuật viên (Staff):</label>
                        <select name="StaffId" class="form-select rounded-3" required>
                            <option value="">-- Chọn kỹ thuật viên --</option>
                            @foreach (var staff in staffList)
                            {
                                <option value="@staff.Id">@staff.FullName (Đang làm: @staff.ActiveCount việc)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        Xác nhận Giao việc
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL TỪ CHỐI TICKET (BẢNG 7.2 TC-06) -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="rejectModalLabel">Từ chối Tiếp nhận Yêu cầu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Reject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="rejectTicketId" name="TicketId" value="" />
                <div class="modal-body py-4">
                    <div class="alert alert-warning py-2 small mb-3">
                        Lưu ý: Chỉ cho phép từ chối các yêu cầu ở trạng thái <strong>Mới tạo (New)</strong>.
                    </div>
                    <p class="small text-muted mb-2">
                        Từ chối yêu cầu <strong id="rejectTicketTitle" class="text-body">#--</strong>:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do từ chối (Bắt buộc):</label>
                        <textarea name="Reason" class="form-control rounded-3" rows="3" placeholder="Nhập lý do không tiếp nhận yêu cầu..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-danger px-4 fw-semibold">
                        Xác nhận Từ chối
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const assignModal = document.getElementById("assignModal");
            if (assignModal) {
                assignModal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    const ticketId = button.getAttribute("data-ticket-id");
                    const title = button.getAttribute("data-ticket-title");
                    document.getElementById("assignTicketId").value = ticketId;
                    document.getElementById("assignTicketTitle").textContent = "#" + ticketId + " - " + title;
                });
            }

            const rejectModal = document.getElementById("rejectModal");
            if (rejectModal) {
                rejectModal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    const ticketId = button.getAttribute("data-ticket-id");
                    const title = button.getAttribute("data-ticket-title");
                    document.getElementById("rejectTicketId").value = ticketId;
                    document.getElementById("rejectTicketTitle").textContent = "#" + ticketId + " - " + title;
                });
            }
        });
    </script>
}
