@model List<UserItemViewModel>
@{
    ViewData["Title"] = "Quản lý người dùng";
    var currentAdminId = ViewBag.CurrentAdminId as int? ?? 0;
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Quản lý người dùng</h3>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="CreateUser" class="btn btn-primary rounded-3 shadow-sm">
            <svg class="bi me-1" width="16" height="16"><use xlink:href="#plus-circle"/></svg>
            Tạo Tài khoản Mới
        </a>
    </div>
</div>

<!-- FORM TÌM KIẾM & BỘ LỌC -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-body">
    <div class="card-body p-4">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Tìm kiếm:</label>
                <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-control rounded-3" placeholder="Username, họ tên, email, phòng ban..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Vai trò:</label>
                <select name="role" class="form-select rounded-3">
                    <option value="">-- Tất cả vai trò --</option>
                    @foreach (UserRole r in Enum.GetValues<UserRole>())
                    {
                        <option value="@r" selected="@(ViewBag.CurrentRole?.ToString() == r.ToString() ? "selected" : null)">@r</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Trạng thái:</label>
                <select name="status" class="form-select rounded-3">
                    <option value="">-- Tất cả trạng thái --</option>
                    @foreach (UserStatus st in Enum.GetValues<UserStatus>())
                    {
                        <option value="@st" selected="@(ViewBag.CurrentStatus?.ToString() == st.ToString() ? "selected" : null)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 rounded-3 shadow-sm">
                    Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH NGƯỜI DÙNG -->
<div class="card border-0 shadow-sm rounded-4 bg-body">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Mã số</th>
                        <th>Tài khoản</th>
                        <th>Họ và tên</th>
                        <th>Email</th>
                        <th>Phòng ban</th>
                        <th>Vai trò</th>
                        <th>Trạng thái</th>
                        <th class="pe-4 text-end">Hành động quản trị</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Không tìm thấy người dùng nào phù hợp với điều kiện tìm kiếm.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model)
                        {
                            var roleBadgeClass = user.Role switch
                            {
                                UserRole.Admin => "bg-danger",
                                UserRole.Leader => "bg-info text-dark",
                                UserRole.Staff => "bg-warning text-dark",
                                _ => "bg-secondary-subtle"
                            };

                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@user.Id</td>
                                <td>
                                    <span class="fw-semibold text-body">@user.Username</span>
                                    @if (user.Id == currentAdminId)
                                    {
                                        <span class="badge bg-secondary-subtle text-muted ms-1" style="font-size: 0.65rem;">(Chính bạn)</span>
                                    }
                                </td>
                                <td>@user.FullName</td>
                                <td><span class="small text-muted">@user.Email</span></td>
                                <td>@(user.Department ?? "N/A")</td>
                                <td><span class="badge @roleBadgeClass">@user.Role</span></td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive (Đã khóa)</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="d-inline-flex align-items-center justify-content-end gap-1">
                                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary btn-action-edit text-center" title="Chỉnh sửa thông tin">
                                            Sửa
                                        </a>

                                        <button type="button" class="btn btn-sm btn-outline-info btn-action-reset text-center" 
                                                data-bs-toggle="modal" data-bs-target="#resetPasswordModal"
                                                data-user-id="@user.Id" data-username="@user.Username" title="Đặt lại mật khẩu">
                                            Reset MK
                                        </button>

                                        <!-- Tự bảo vệ: Chặn Admin tự vô hiệu hóa tài khoản của chính mình -->
                                        @if (user.Id == currentAdminId)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary btn-action-toggle text-center" disabled 
                                                    title="Bạn không thể tự khóa tài khoản quản trị của chính mình">
                                                Khóa
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="ToggleActive" method="post" class="d-inline m-0">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@user.Id" />
                                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success") btn-action-toggle text-center"
                                                        onclick="return confirm('Bạn có chắc chắn muốn @(user.IsActive ? "vô hiệu hóa" : "kích hoạt lại") tài khoản @user.Username?');">
                                                    @(user.IsActive ? "Khóa" : "Kích hoạt")
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL RESET MẬT KHẨU -->
<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="resetPasswordModalLabel">Đặt lại Mật khẩu Người dùng</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="resetUserId" name="UserId" value="" />
                <div class="modal-body py-4">
                    <p class="small text-muted mb-3">
                        Thiết lập mật khẩu mới cho tài khoản <strong id="resetUsername" class="text-body">--</strong>:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu mới (Tối thiểu 6 ký tự):</label>
                        <input type="password" name="NewPassword" class="form-control rounded-3" placeholder="Nhập mật khẩu mới..." required minlength="6" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        Cập nhật Mật khẩu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const resetModal = document.getElementById("resetPasswordModal");
            if (resetModal) {
                resetModal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    const userId = button.getAttribute("data-user-id");
                    const username = button.getAttribute("data-username");
                    document.getElementById("resetUserId").value = userId;
                    document.getElementById("resetUsername").textContent = username;
                });
            }
        });
    </script>
}
