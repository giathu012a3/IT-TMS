@model UserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Dashboard</h3>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" asp-controller="Ticket" class="btn btn-primary shadow-sm rounded-3">
            <svg class="bi me-1" width="16" height="16"><use xlink:href="#plus-circle"/></svg>
            Tạo Yêu cầu Hỗ trợ Mới
        </a>
    </div>
</div>

<!-- DẢI CHỈ SỐ KPI (MODERN SAAS ELEVATED KPI CARDS) -->
<section class="kpis mb-4">
    <div class="kpi">
        <div class="kpi-label">
            <span>Tổng yêu cầu đã gửi</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#ticket-perforated"/></svg>
        </div>
        <div class="kpi-value">@Model.TotalTickets</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Đang được xử lý</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#speedometer2"/></svg>
        </div>
        <div class="kpi-value">@Model.ProcessingTickets</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Đã giải quyết</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#check-circle-fill"/></svg>
        </div>
        <div class="kpi-value pos">@Model.ResolvedTickets</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Chờ đánh giá chất lượng</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#star-fill"/></svg>
        </div>
        <div class="kpi-value @(Model.WaitingFeedbackTickets > 0 ? "warn" : "")">@Model.WaitingFeedbackTickets</div>
    </div>
</section>

<!-- BẢNG YÊU CẦU GẦN ĐÂY -->
<div class="card border-0 shadow-sm rounded-4 bg-body">
    <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0">Yêu cầu gần đây của bạn</h5>
        <a asp-action="Index" asp-controller="Ticket" class="small text-decoration-none">Xem tất cả &rarr;</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Mã vé</th>
                        <th>Tiêu đề sự cố</th>
                        <th>Danh mục</th>
                        <th>Ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Hạn cam kết SLA</th>
                        <th class="pe-4 text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentTickets.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                Bạn chưa tạo yêu cầu hỗ trợ nào. Nhấn <strong>"Tạo Yêu cầu Hỗ trợ Mới"</strong> để bắt đầu.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@ticket.Id</td>
                                <td>
                                    <a asp-action="Details" asp-controller="Ticket" asp-route-id="@ticket.Id" class="text-decoration-none fw-semibold text-body">
                                        @ticket.Title
                                    </a>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-body border">@ticket.Category</span></td>
                                <td>
                                    <span class="badge @(ticket.Priority == TicketPriority.Critical ? "bg-danger" : ticket.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @ticket.StatusColorClass">@ticket.StatusLabel</span>
                                </td>
                                <td>
                                    @await Html.PartialAsync("_SlaBadge", (ticket.DueAt, ticket.StatusId, ticket.ResolvedAt))
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-controller="Ticket" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-secondary">
                                        Xem chi tiết
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
