@model CreateUserViewModel
@{
    ViewData["Title"] = "Tạo Tài khoản Người dùng Mới";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-body">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                    &larr;
                </a>
                <div>
                    <h4 class="fw-bold mb-0">Tạo Tài khoản Người dùng Mới</h4>
                    <span class="text-muted small">Cấp phát tài khoản và phân quyền vai trò</span>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-semibold small"></label>
                        <input asp-for="Username" class="form-control rounded-3" placeholder="Ví dụ: nva_it" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="name@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold small"></label>
                        <input asp-for="FullName" class="form-control rounded-3" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold small"></label>
                        <input asp-for="Password" type="password" class="form-control rounded-3" placeholder="Tối thiểu 6 ký tự" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label fw-semibold small"></label>
                        <select asp-for="Role" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<UserRole>()"></select>
                        <span asp-validation-for="Role" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-semibold small"></label>
                        <input asp-for="Department" class="form-control rounded-3" placeholder="Phòng CNTT / Kế toán / Nhân sự..." />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        <svg class="bi me-1" width="16" height="16"><use xlink:href="#plus-circle"/></svg>
                        Khởi tạo Tài khoản
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
