@model EditUserViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa Người dùng: {Model.Username}";
}

<div class="row justify-content-center py-2">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0 rounded-4 p-4 p-md-5 bg-body">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-circle" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                    &larr;
                </a>
                <div>
                    <h4 class="fw-bold mb-0">Chỉnh sửa Thông tin Người dùng</h4>
                    <span class="text-muted small">Cập nhật hồ sơ và vai trò của tài khoản <strong>@Model.Username</strong></span>
                </div>
            </div>

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold small">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control rounded-3" readonly disabled />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label fw-semibold small"></label>
                        <input asp-for="FullName" class="form-control rounded-3" />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-semibold small"></label>
                        <input asp-for="Department" class="form-control rounded-3" />
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Role" class="form-label fw-semibold small"></label>
                    <select asp-for="Role" class="form-select rounded-3" asp-items="Html.GetEnumSelectList<UserRole>()"></select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
