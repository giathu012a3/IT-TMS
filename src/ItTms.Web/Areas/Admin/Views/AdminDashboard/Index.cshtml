@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Dashboard</h3>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-action="Create" asp-controller="User" class="btn btn-primary rounded-3 shadow-sm">
            <svg class="bi me-1" width="16" height="16"><use xlink:href="#plus-circle"/></svg>
            Thêm người dùng
        </a>
    </div>
</div>

<!-- DẢI CHỈ SỐ HỆ THỐNG -->
<section class="kpis mb-4">
    <div class="kpi">
        <div class="kpi-label">
            <span>Tổng tài khoản</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#people-fill"/></svg>
        </div>
        <div class="kpi-value">@Model.TotalUsers</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Đang hoạt động</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#check-circle-fill"/></svg>
        </div>
        <div class="kpi-value pos">@Model.ActiveUsers</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Tổng yêu cầu hệ thống</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#ticket-perforated"/></svg>
        </div>
        <div class="kpi-value">@Model.TotalTickets</div>
    </div>
    <div class="kpi">
        <div class="kpi-label">
            <span>Nhật ký kiểm toán</span>
            <svg class="bi" width="18" height="18"><use xlink:href="#journal-text"/></svg>
        </div>
        <div class="kpi-value">@Model.TotalLogs</div>
    </div>
</section>

<div class="row g-4 mb-4">
    <!-- CƠ CẤU VAI TRÒ -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                <h5 class="fw-bold mb-1">Cơ cấu Vai trò Người dùng</h5>
                <span class="text-muted small">Phân bổ nhân sự theo 4 vai trò</span>
            </div>
            <div class="card-body px-4">
                <div class="list-group list-group-flush">
                    @foreach (var kvp in Model.RoleCounts)
                    {
                        var badgeClass = kvp.Key switch
                        {
                            "Admin" => "bg-danger",
                            "Leader" => "bg-info text-dark",
                            "Staff" => "bg-warning text-dark",
                            _ => "bg-secondary-subtle"
                        };

                        <div class="list-group-item d-flex justify-content-between align-items-center px-0 bg-transparent py-3">
                            <span class="badge @badgeClass fs-7 px-3 py-2">@kvp.Key</span>
                            <span class="fw-bold fs-6">@kvp.Value tài khoản</span>
                        </div>
                    }
                </div>
                <div class="mt-3 text-center">
                    <a asp-action="Index" asp-controller="User" class="btn btn-sm btn-outline-secondary w-100">
                        Quản lý Người dùng &rarr;
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- NHẬT KÝ KIỂM TOÁN GẦN ĐÂY -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 bg-body h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">Nhật ký Kiểm toán Mới nhất</h5>
                    <span class="text-muted small">10 sự kiện thao tác bảo mật và biến động gần nhất</span>
                </div>
                <a asp-action="Index" asp-controller="Audit" class="small text-decoration-none">Toàn bộ nhật ký &rarr;</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Thời gian</th>
                                <th>Hành vi</th>
                                <th>Người thực hiện</th>
                                <th>Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.RecentLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">Chưa có nhật ký nào được ghi nhận.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model.RecentLogs)
                                {
                                    <tr>
                                        <td class="ps-4 text-muted text-nowrap">@log.FormattedTime</td>
                                        <td>
                                            <span class="badge bg-secondary-subtle text-body border">@log.Action</span>
                                        </td>
                                        <td class="fw-semibold">@log.UserName</td>
                                        <td class="text-truncate" style="max-width: 280px;" title="@log.Details">
                                            @log.Details
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
