@{
    ViewData["Title"] = "Vai trò & Phân quyền";
    var usersByRole = ViewBag.UsersByRole as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Vai trò & Phân quyền</h3>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a asp-controller="User" asp-action="Index" class="btn btn-outline-primary rounded-3 shadow-sm">
            <svg class="bi me-1" width="16" height="16"><use xlink:href="#people"/></svg>
            Quản lý tài khoản
        </a>
    </div>
</div>

<!-- THỐNG KÊ TÀI KHOẢN THEO VAI TRÒ -->
<div class="row g-3 mb-4">
    @{
        var roles = new[]
        {
            new { Role = UserRole.Admin, Title = "Quản trị viên", Description = "Quản trị cấu hình, phân quyền tài khoản, nhật ký kiểm toán hệ thống.", Badge = "bg-danger", Border = "border-danger", Icon = "gear" },
            new { Role = UserRole.Leader, Title = "Trưởng nhóm IT", Description = "Tiếp nhận yêu cầu, phân công kỹ thuật viên, giám sát tiến độ và SLA.", Badge = "bg-info text-dark", Border = "border-info", Icon = "clipboard-check" },
            new { Role = UserRole.Staff, Title = "Kỹ thuật viên", Description = "Xử lý yêu cầu được giao, cập nhật tiến độ, ghi chú kỹ thuật nội bộ.", Badge = "bg-warning text-dark", Border = "border-warning", Icon = "tools" },
            new { Role = UserRole.User, Title = "Người dùng", Description = "Gửi yêu cầu hỗ trợ, theo dõi tiến độ, trao đổi và đánh giá chất lượng.", Badge = "bg-secondary-subtle", Border = "border-secondary", Icon = "person" }
        };
    }

    @foreach (var r in roles)
    {
        var roleStat = usersByRole.FirstOrDefault(x => x.Role == r.Role);
        int total = roleStat?.TotalCount ?? 0;
        int active = roleStat?.ActiveCount ?? 0;

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100 bg-body border-start border-4 @r.Border">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge @r.Badge rounded-pill px-3 py-1">@r.Role</span>
                        <a asp-controller="User" asp-action="Index" asp-route-role="@r.Role" class="text-decoration-none small text-muted">
                            Xem danh sách &rarr;
                        </a>
                    </div>
                    <h5 class="fw-bold mb-1">@r.Title</h5>
                    <p class="text-muted small mb-3">@r.Description</p>
                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                        <span class="text-muted small">Tổng tài khoản:</span>
                        <span class="fw-bold fs-6">@total <small class="text-success fw-normal">(@active đang hoạt động)</small></span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

