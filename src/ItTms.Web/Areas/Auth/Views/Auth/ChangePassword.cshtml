@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu cá nhân";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-4 p-4 bg-body">
            <h4 class="fw-bold mb-3 d-flex align-items-center">
                <svg class="bi me-2" width="22" height="22"><use xlink:href="#lock-fill"/></svg>
                Đổi mật khẩu tài khoản
            </h4>
            <p class="text-muted small mb-4">Vui lòng nhập mật khẩu hiện tại và mật khẩu mới để bảo vệ an toàn tài khoản.</p>

            <form asp-action="ChangePassword" asp-controller="Auth" asp-area="Auth" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="CurrentPassword" class="form-control rounded-3" placeholder="Nhập mật khẩu hiện tại" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="NewPassword" class="form-control rounded-3" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                    <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="Nhập lại mật khẩu mới" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary">Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">Xác nhận đổi mật khẩu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
