@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập Hệ thống";
    ViewData["HideTaskbar"] = true;
}

<div class="auth-centered-shell d-flex flex-column justify-content-center align-items-center min-vh-100 p-3 position-relative" style="background-color: var(--ground);">
    <!-- Theme Toggle Button in Top-Right Corner -->
    <div class="position-absolute top-0 end-0 p-3 p-md-4">
        <button class="btn taskbar-icon-btn" id="btnThemeToggle" title="Chuyển đổi giao diện Sáng/Tối" type="button">
            <svg class="bi" width="16" height="16" id="themeIcon"><use xlink:href="#moon-fill"/></svg>
        </button>
    </div>

    <!-- MAIN AUTH CARD -->
    <div class="auth-card-box p-4 p-md-5 rounded-4 border shadow-sm" style="width: 100%; max-width: 440px; background-color: var(--surface);">
        <!-- BRAND IDENTITY -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center app-brand-mark mb-3" style="width: 44px; height: 44px; border-radius: 10px;">
                <svg class="bi" width="24" height="24"><use xlink:href="#shield-check"/></svg>
            </div>
            <h4 class="fw-bold mb-1">IT-TMS Service Desk</h4>
            <p class="text-muted small mb-0">Hệ thống Tiếp nhận &amp; Xử lý Sự cố Kỹ thuật</p>
        </div>

        <!-- LOGIN FORM -->
        <form asp-action="Login" asp-controller="Auth" asp-area="Auth" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Username" class="form-label fw-semibold small">Tên đăng nhập hoặc Email</label>
                <input asp-for="Username" class="form-control rounded-3" placeholder="Nhập tài khoản" id="inputUsername" autofocus />
                <span asp-validation-for="Username" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold small">Mật khẩu</label>
                <input asp-for="Password" class="form-control rounded-3" type="password" placeholder="••••••••" id="inputPassword" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck">
                    <label class="form-check-label small text-muted" for="rememberMeCheck">
                        Duy trì đăng nhập
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold rounded-3 shadow-sm" id="loginBtn">
                Đăng nhập
            </button>
        </form>

        <!-- SUBTLE DEMO SHORTCUTS (THU GỌN TINH TẾ) -->
        <div class="mt-4 pt-3 border-top text-center">
            <div class="text-muted small mb-2" style="font-size: 0.8rem;">Tài khoản mẫu trải nghiệm nhanh:</div>
            <div class="d-flex flex-wrap justify-content-center gap-1">
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 quick-fill-btn rounded-2" onclick="fillCreds('admin', 'Admin@123', this)">
                    admin
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 quick-fill-btn rounded-2" onclick="fillCreds('leader', 'Leader@123', this)">
                    leader
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 quick-fill-btn rounded-2" onclick="fillCreds('staff1', 'Staff@123', this)">
                    staff1
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 quick-fill-btn rounded-2" onclick="fillCreds('user1', 'User@123', this)">
                    user1
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2 quick-fill-btn rounded-2" onclick="fillCreds('inactive_user', 'User@123', this)">
                    inactive_user
                </button>
            </div>
        </div>
    </div>

    <!-- COMPACT FOOTER -->
    <div class="text-center text-muted small mt-4" style="font-size: 0.78rem;">
        &copy; 2026 IT-TMS Enterprise Service Desk &bull; Cổng dịch vụ nội bộ
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillCreds(username, password, btn) {
            var u = document.getElementById("inputUsername");
            var p = document.getElementById("inputPassword");
            if (u) u.value = username;
            if (p) p.value = password;
            document.querySelectorAll(".quick-fill-btn").forEach(function(b) {
                b.classList.remove("active", "btn-secondary");
                b.classList.add("btn-outline-secondary");
            });
            if (btn) {
                btn.classList.add("active", "btn-secondary");
                btn.classList.remove("btn-outline-secondary");
                btn.blur();
            }
        }
    </script>
}
