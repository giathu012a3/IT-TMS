@model List<TicketListItemViewModel>
@{
    ViewData["Title"] = "Danh sách yêu cầu";
    var staffList = ViewBag.StaffList as IEnumerable<ItTms.Domain.Entities.User> ?? Enumerable.Empty<ItTms.Domain.Entities.User>();
    var statuses = ViewBag.Statuses as IEnumerable<ItTms.Domain.Entities.TicketStatus> ?? Enumerable.Empty<ItTms.Domain.Entities.TicketStatus>();
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Danh sách yêu cầu</h3>
    </div>
</div>

<!-- FORM TÌM KIẾM ĐA TIÊU CHÍ -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-body">
    <div class="card-body p-4">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Từ khóa tìm kiếm:</label>
                <input type="text" name="keyword" value="@ViewBag.CurrentKeyword" class="form-control rounded-3" placeholder="Mã vé, tiêu đề, tên nhân sự..." />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Trạng thái:</label>
                <select name="statusId" class="form-select rounded-3">
                    <option value="">-- Tất cả trạng thái --</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s.Id" selected="@(ViewBag.CurrentStatus == s.Id ? "selected" : null)">@s.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold">Kỹ thuật viên phụ trách:</label>
                <select name="staffId" class="form-select rounded-3">
                    <option value="">-- Tất cả kỹ thuật viên --</option>
                    @foreach (var staff in staffList)
                    {
                        <option value="@staff.Id" selected="@(ViewBag.CurrentStaff == staff.Id ? "selected" : null)">@staff.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100 rounded-3 shadow-sm">
                    Lọc dữ liệu
                </button>
            </div>
        </form>
    </div>
</div>

<!-- BẢNG DANH SÁCH -->
<div class="card border-0 shadow-sm rounded-4 bg-body">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Mã vé</th>
                        <th>Tiêu đề sự cố</th>
                        <th>Người tạo</th>
                        <th>Kỹ thuật viên</th>
                        <th>Ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Hạn cam kết SLA</th>
                        <th class="pe-4 text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                Không tìm thấy yêu cầu nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@ticket.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="fw-semibold text-body text-decoration-none d-block">
                                        @ticket.Title
                                    </a>
                                    <span class="small text-muted">@ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>@ticket.CreatorName</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(ticket.AssignedToName))
                                    {
                                        <span class="fw-semibold small">@ticket.AssignedToName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Chưa phân công</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(ticket.Priority == TicketPriority.Critical ? "bg-danger" : ticket.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td><span class="badge @ticket.StatusColorClass">@ticket.StatusLabel</span></td>
                                <td>@await Html.PartialAsync("_SlaBadge", (ticket.DueAt, ticket.StatusId, ticket.ResolvedAt))</td>
                                <td class="pe-4 text-end">
                                    <div class="d-flex justify-content-end gap-1">
                                        @if (ticket.StatusId == TicketStatus.Assigned || ticket.StatusId == TicketStatus.InProgress || ticket.StatusId == TicketStatus.Waiting)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning" 
                                                    data-bs-toggle="modal" data-bs-target="#reassignModal"
                                                    data-ticket-id="@ticket.Id" data-ticket-title="@ticket.Title">
                                                Điều chuyển
                                            </button>
                                        }
                                        <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-secondary">
                                            Chi tiết
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL ĐIỀU CHUYỂN KỸ THUẬT VIÊN -->
<div class="modal fade" id="reassignModal" tabindex="-1" aria-labelledby="reassignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="reassignModalLabel">Điều chuyển Kỹ thuật viên Xử lý</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Reassign" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="reassignTicketId" name="TicketId" value="" />
                <div class="modal-body py-4">
                    <p class="small text-muted mb-3">
                        Tái phân công yêu cầu <strong id="reassignTicketTitle" class="text-body">#--</strong> sang kỹ thuật viên khác:
                    </p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Chọn Kỹ thuật viên mới:</label>
                        <select name="NewStaffId" class="form-select rounded-3" required>
                            <option value="">-- Chọn kỹ thuật viên mới --</option>
                            @foreach (var staff in staffList)
                            {
                                <option value="@staff.Id">@staff.FullName</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning px-4 fw-semibold text-dark">
                        Xác nhận Điều chuyển
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const reassignModal = document.getElementById("reassignModal");
            if (reassignModal) {
                reassignModal.addEventListener("show.bs.modal", function (event) {
                    const button = event.relatedTarget;
                    const ticketId = button.getAttribute("data-ticket-id");
                    const title = button.getAttribute("data-ticket-title");
                    document.getElementById("reassignTicketId").value = ticketId;
                    document.getElementById("reassignTicketTitle").textContent = "#" + ticketId + " - " + title;
                });
            }
        });
    </script>
}
