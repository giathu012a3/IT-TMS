@model List<TicketListItemViewModel>
@{
    ViewData["Title"] = "Công việc được phân công";
    var activeTab = ViewBag.ActiveTab as string ?? "active";
}

<div class="row align-items-center mb-4">
    <div class="col-md-8">
        <h3 class="fw-bold mb-0">Công việc được phân công</h3>
    </div>
</div>

<!-- TABS LỌC TRẠNG THÁI -->
<ul class="nav nav-pills mb-4 bg-body p-2 rounded-4 shadow-sm">
    <li class="nav-item">
        <a class="nav-link rounded-3 @(activeTab == "active" ? "active" : "")" asp-action="Assigned" asp-route-tab="active">
            Đang xử lý
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-3 @(activeTab == "resolved" ? "active" : "")" asp-action="Assigned" asp-route-tab="resolved">
            Đã hoàn thành
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-3 @(activeTab == "closed" ? "active" : "")" asp-action="Assigned" asp-route-tab="closed">
            Đã đóng
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link rounded-3 @(activeTab == "all" ? "active" : "")" asp-action="Assigned" asp-route-tab="all">
            Tất cả
        </a>
    </li>
</ul>

<!-- DANH SÁCH BẢNG CÔNG VIỆC -->
<div class="card border-0 shadow-sm rounded-4 bg-body">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Mã vé</th>
                        <th>Tiêu đề sự cố</th>
                        <th>Người yêu cầu</th>
                        <th>Mức ưu tiên</th>
                        <th>Trạng thái</th>
                        <th>Hạn cam kết SLA</th>
                        <th class="pe-4 text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Không có yêu cầu nào trong hàng đợi này.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var ticket in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold font-monospace text-muted">#@ticket.Id</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="fw-semibold text-body text-decoration-none d-block">
                                        @ticket.Title
                                    </a>
                                    <span class="small text-muted">Tạo lúc: @ticket.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                </td>
                                <td>
                                    <span class="fw-semibold small">@ticket.CreatorName</span>
                                </td>
                                <td>
                                    <span class="badge @(ticket.Priority == TicketPriority.Critical ? "bg-danger" : ticket.Priority == TicketPriority.High ? "bg-warning" : "bg-secondary-subtle")">
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td><span class="badge @ticket.StatusColorClass">@ticket.StatusLabel</span></td>
                                <td>@await Html.PartialAsync("_SlaBadge", (ticket.DueAt, ticket.StatusId, ticket.ResolvedAt))</td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn btn-sm btn-outline-secondary">
                                        Xử lý &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
