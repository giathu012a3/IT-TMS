@model (DateTime DueAt, int StatusId, DateTime? ResolvedAt)

@{
    var now = DateTime.UtcNow;
    var isFinished = Model.StatusId == 5 || Model.StatusId == 6 || Model.StatusId == 7;
    var isOverdue = !isFinished && now > Model.DueAt;
    var wasBreached = Model.ResolvedAt.HasValue && Model.ResolvedAt.Value > Model.DueAt;
    var timeRemaining = Model.DueAt - now;
}

@if (wasBreached)
{
    <span class="badge bg-danger-subtle" title="Đã hoàn thành nhưng trễ hạn cam kết SLA">
        <svg class="bi me-1" width="12" height="12"><use xlink:href="#exclamation-triangle-fill"/></svg>
        Trễ hạn SLA
    </span>
}
else if (isOverdue)
{
    <span class="badge badge-sla-overdue" title="Đã vượt quá hạn cam kết SLA">
        <svg class="bi me-1" width="12" height="12"><use xlink:href="#exclamation-triangle-fill"/></svg>
        Quá hạn SLA
    </span>
}
else if (!isFinished)
{
    @if (timeRemaining.TotalHours < 1)
    {
        <span class="badge bg-warning-subtle" title="Sắp hết hạn SLA (< 1 giờ)">
            <svg class="bi me-1" width="12" height="12"><use xlink:href="#clock"/></svg>
            Còn @Math.Max(1, (int)timeRemaining.TotalMinutes) phút
        </span>
    }
    else if (timeRemaining.TotalHours < 24)
    {
        <span class="badge bg-secondary-subtle" title="Thời gian SLA còn lại">
            <svg class="bi me-1" width="12" height="12"><use xlink:href="#clock"/></svg>
            Còn @((int)timeRemaining.TotalHours) giờ
        </span>
    }
    else
    {
        <span class="badge bg-secondary-subtle" title="Thời gian SLA còn lại">
            <svg class="bi me-1" width="12" height="12"><use xlink:href="#clock"/></svg>
            Còn @((int)timeRemaining.TotalDays) ngày
        </span>
    }
}
else
{
    <span class="badge bg-success-subtle" title="Đã hoàn thành đúng hạn cam kết SLA">
        <svg class="bi me-1" width="12" height="12"><use xlink:href="#check-circle-fill"/></svg>
        Đúng hạn SLA
    </span>
}
