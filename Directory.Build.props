<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Enforce zero-warning compilation -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- Code analysis & determinism -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>

    <!-- Avoid CS1591 missing XML comments, naming keyword collisions (CA1716, CA1000), logger delegates (CA1848), and EF migrations generated arrays (CA1861) -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1716;CA1000;CA1848;CA1861</NoWarn>
  </PropertyGroup>

  <!-- Special config for test projects -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' And $(MSBuildProjectName.EndsWith('Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Cho phép đặt tên hàm test có dấu gạch dưới theo chuẩn Unit Testing xUnit (CA1707) -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>
